local function getOreColor(name)
    local lower = name:lower()
    if lower:find("coal") then return Color3.fromRGB(30, 30, 30), Color3.fromRGB(80, 80, 80)
    elseif lower:find("azurium") or lower:find("azure") then return Color3.fromRGB(30, 120, 255), Color3.fromRGB(100, 180, 255)
    elseif lower:find("iron") then return Color3.fromRGB(160, 160, 160), Color3.fromRGB(210, 210, 210)
    elseif lower:find("gold") then return Color3.fromRGB(255, 215, 0), Color3.fromRGB(255, 240, 150)
    elseif lower:find("copper") then return Color3.fromRGB(184, 115, 51), Color3.fromRGB(222, 140, 75)
    elseif lower:find("silver") then return Color3.fromRGB(192, 192, 192), Color3.fromRGB(230, 230, 230)
    elseif lower:find("manacite") then return Color3.fromRGB(157, 143, 239), Color3.fromRGB(198, 189, 252)
    elseif lower:find("ruby") or lower:find("red") then return Color3.fromRGB(220, 30, 30), Color3.fromRGB(255, 100, 100)
    elseif lower:find("sapphire") then return Color3.fromRGB(20, 60, 220), Color3.fromRGB(100, 140, 255)
    elseif lower:find("emerald") or lower:find("green") then return Color3.fromRGB(40, 200, 80), Color3.fromRGB(120, 255, 160)
    else return Color3.fromRGB(150, 150, 150), Color3.fromRGB(200, 200, 200) end
end

local function refreshVeins()
    local runWorld = Workspace:FindFirstChild("RunWorld")
    for item, data in pairs(activeTags) do
        if data.Highlight and data.Highlight.Name:find("VeinsTag") then removeTag(item) end
    end
    if not veinsEnabled or not runWorld then return end

    for _, item in ipairs(runWorld:GetDescendants()) do
        if item.ClassName == "BasePart" or item.ClassName == "Model" then
            local nameLower = item.Name:lower()
            if not nameLower:find("golden") and not nameLower:find("seamvein") then
                if not nameLower:match("^ore%d+$") and not nameLower:match("^rock%s*%d+$") and not nameLower:match("^rock%d*$") and not nameLower:find("bedrock") then
                    if nameLower:find("ore") or nameLower:find("vein") or nameLower:find("rock") or nameLower:find("node") or nameLower:find("coal") or nameLower:find("azurium") or nameLower:find("iron") or nameLower:find("gold") or nameLower:find("copper") or nameLower:find("silver") or nameLower:find("manacite") or nameLower:find("gem") then
                        local primaryPart = item:IsA("Model") and (item.PrimaryPart or item:FindFirstChildWhichIsA("BasePart")) or (item:IsA("BasePart") and item)
                        if primaryPart and isInRange(primaryPart) then
                            applyTag(item, getOreColor(item.Name), select(2, getOreColor(item.Name)), "VeinsTag")
                        end
                    end
                end
            end
        end
    end
end

