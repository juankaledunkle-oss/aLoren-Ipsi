local function teleportToPortalOrRunWorld(rootPart)
    local portal = Workspace:FindFirstChild("Portal")
    local targetPart = nil

    if portal then
        if portal:IsA("Model") then
            targetPart = portal.PrimaryPart or portal:FindFirstChildWhichIsA("BasePart")
        elseif portal:IsA("BasePart") then
            targetPart = portal
        end
    end

    if not targetPart then
        local runWorld = Workspace:FindFirstChild("RunWorld")
        if runWorld then
            if runWorld:IsA("Model") then
                targetPart = runWorld.PrimaryPart or runWorld:FindFirstChildWhichIsA("BasePart")
            elseif runWorld:IsA("BasePart") then
                targetPart = runWorld
            end
        end
    end

    if targetPart then
        local pos = targetPart:IsA("Model") and targetPart:GetPivot().Position or targetPart.Position
        rootPart.CFrame = CFrame.new(pos + Vector3.new(0, 5, 0))
        rootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
    end
end

local function startFly()
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not root or not hum then return end
    
    hum.PlatformStand = true
    if bg then bg:Destroy() end
    if bv then bv:Destroy() end
    
    bg = Instance.new("BodyGyro", root)
    bg.P = 9e4
    bg.maxTorque = Vector3.new(9e4, 9e4, 9e4)
    bg.cframe = root.CFrame
    
    bv = Instance.new("BodyVelocity", root)
    bv.Velocity = Vector3.new(0, 0, 0)
    bv.MaxForce = Vector3.new(9e4, 9e4, 9e4)

    if flyConnection then flyConnection:Disconnect() end
    
    flyConnection = RunService.RenderStepped:Connect(function()
        local currentCharacter = LocalPlayer.Character
        local currentRoot = currentCharacter and currentCharacter:FindFirstChild("HumanoidRootPart")
        local currentHum = currentCharacter and currentCharacter:FindFirstChildOfClass("Humanoid")
        
        if not currentCharacter or not currentRoot or not bv or not bg then return end

        bg.cframe = Camera.CFrame
        local moveDir = Vector3.new()
        local moveVector = currentHum and currentHum.MoveDirection or Vector3.new()
        
        if moveVector.Magnitude > 0 then
            local camCF = Camera.CFrame
            local flatMove = camCF:VectorToObjectSpace(moveVector)
            moveDir = (camCF.LookVector * -flatMove.Z) + (camCF.RightVector * flatMove.X)
        end

        if UserInputService:IsKeyDown(Enum.KeyCode.W) then moveDir = moveDir + Camera.CFrame.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then moveDir = moveDir - Camera.CFrame.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then moveDir = moveDir - Camera.CFrame.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then moveDir = moveDir + Camera.CFrame.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) then moveDir = moveDir + Vector3.new(0, 1, 0) end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then moveDir = moveDir - Vector3.new(0, 1, 0) end

        if moveDir.Magnitude > 0 then
            bv.Velocity = moveDir.Unit * flySpeed
        else
            bv.Velocity = Vector3.new(0, 0.1, 0)
        end
    end)
end

local function stopFly()
    if flyConnection then flyConnection:Disconnect() flyConnection = nil end
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if hum and not swimEnabled then hum.PlatformStand = false end
    if bg then bg:Destroy() bg = nil end
    if bv then bv:Destroy() bv = nil end
end

