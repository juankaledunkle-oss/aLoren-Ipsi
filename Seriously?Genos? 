local raycastParams = RaycastParams.new()
raycastParams.FilterType = Enum.RaycastFilterType.Exclude

RunService.Heartbeat:Connect(function(dt)
    local character = LocalPlayer.Character
    local rootPart = character and character:FindFirstChild("HumanoidRootPart")
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    
    if not character or not rootPart or not humanoid then return end

    if loopRefreshEnabled then
        refreshAccumulator = refreshAccumulator + dt
        if refreshAccumulator >= 1.0 then
            refreshAccumulator = 0
            refreshAllActiveESPs()
        end
    end

    if lootEspEnabled then
        refreshLootESP()
    end

    if hoverEnabled and not flyEnabled then
        raycastParams.FilterDescendantsInstances = {character}
        local rayResult = Workspace:Raycast(rootPart.Position + Vector3.new(0, 2, 0), Vector3.new(0, -150, 0), raycastParams)
        if rayResult then
            local targetHeight = rayResult.Position.Y + 33.0
            if rootPart.Position.Y < targetHeight or rootPart.AssemblyLinearVelocity.Y < 1 then
                rootPart.CFrame = CFrame.new(rootPart.Position.X, targetHeight, rootPart.Position.Z) * (rootPart.CFrame - rootPart.CFrame.Position)
                rootPart.AssemblyLinearVelocity = Vector3.new(rootPart.AssemblyLinearVelocity.X, 0, rootPart.AssemblyLinearVelocity.Z)
            end
        end
    end

    local npcsFolder = Workspace:FindFirstChild("NPCs")
    if not npcsFolder then return end

    frameAccumulator = frameAccumulator + 1
    if frameAccumulator >= 8 or #cachedEnemies == 0 then
        frameAccumulator = 0
        cachedEnemies = npcsFolder:GetChildren()
    end

    local closestEnemyModel = nil
    local closestPart = nil
    local shortestDistance = math.huge

    for i = 1, #cachedEnemies do
        local enemy = cachedEnemies[i]
        if enemy and enemy.Parent then
            if selectedTargetName == "ALL" or enemy.Name == selectedTargetName then
                local enemyPart = enemy.ClassName == "Model" and (enemy.PrimaryPart or enemy:FindFirstChildWhichIsA("BasePart")) or (enemy.ClassName == "BasePart" and enemy)
                if enemyPart then
                    local distance = (rootPart.Position - enemyPart.Position).Magnitude
                    if distance < shortestDistance then
                        shortestDistance = distance
                        closestEnemyModel = enemy
                        closestPart = enemyPart
                    end
                end
            end
        end
    end

    if closestPart then
        if autoKillEnabled then
            humanoid:SetStateEnabled(Enum.HumanoidStateType.Swimming, true)
            humanoid:ChangeState(Enum.HumanoidStateType.Swimming)

            local currentDistanceToTarget = (rootPart.Position - closestPart.Position).Magnitude

            if currentDistanceToTarget > 50.0 then
                local dir = (closestPart.Position - rootPart.Position).Unit
                rootPart.CFrame = CFrame.new(rootPart.Position + (dir * math.min(akSpeed * dt, currentDistanceToTarget)), closestPart.Position)
                rootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            else
                local targetCF = closestPart.CFrame
                local isBossTarget = closestEnemyModel and bossTargetNames[closestEnemyModel.Name] == true

                if isBossTarget then
                    orbitAngle = orbitAngle + (dt * 18)
                    local orbitRadius = 12.0
                    local offsetX = math.cos(orbitAngle) * orbitRadius
                    local offsetZ = math.sin(orbitAngle) * orbitRadius
                    local desiredPos = targetCF.Position + Vector3.new(offsetX, 2.0, offsetZ)

                    rootPart.CFrame = CFrame.new(desiredPos, targetCF.Position)
                    rootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                else
                    swapTimer = swapTimer + dt
                    if swapTimer >= 5.0 then
                        swapTimer = 0
                        activeAutoKillMode = activeAutoKillMode % 3 + 1
                    end

                    if activeAutoKillMode == 3 then
                        orbitAngle = orbitAngle + (dt * 35)
                        local orbitRadius = 12.0
                        local offsetX = math.cos(orbitAngle) * orbitRadius
                        local offsetZ = math.sin(orbitAngle) * orbitRadius
                        local desiredPos = targetCF.Position + Vector3.new(offsetX, 1.5, offsetZ)

                        rootPart.CFrame = CFrame.new(desiredPos, targetCF.Position)
                        rootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                    else
                        local verticalOffset = (activeAutoKillMode == 1) and 9.0 or -9.0
                        local desiredPos = targetCF.Position 
                            + (targetCF.RightVector * akHorizontalOffset) 
                            + (targetCF.LookVector * akDepthOffset) 
                            + Vector3.new(0, verticalOffset, 0)
                        
                        rootPart.CFrame = CFrame.new(desiredPos, targetCF.Position)
                        rootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                    end
                end

                attackCooldown = attackCooldown - dt
                if attackCooldown <= 0 then
                    attackCooldown = 0.25
                    local combatActionRemote = ReplicatedStorage:FindFirstChild("Network") and ReplicatedStorage.Network:FindFirstChild("CombatAction")
                    if combatActionRemote then
                        pcall(function()
                            combatActionRemote:FireServer("Light", closestEnemyModel, closestPart.Position)
                        end)
                    end
                end
            end
        else
            swapTimer = 0
            orbitAngle = 0
        end
    end
end)

