local function getRootPosition()
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    return root and root.Position or nil
end

local function isInRange(itemPart)
    local rootPos = getRootPosition()
    if not rootPos then return false end
    local targetPos = itemPart:IsA("Model") and (itemPart.PrimaryPart and itemPart.PrimaryPart.Position or itemPart:GetPivot().Position) or (itemPart:IsA("BasePart") and itemPart.Position or nil)
    if not targetPos then return false end
    return (rootPos - targetPos).Magnitude <= ESP_MAX_DISTANCE
end

local function refreshGoldenFlowers()
    local targetFolder = Workspace:FindFirstChild("RunWorld")
    local island1 = targetFolder and targetFolder:FindFirstChild("Island1")
    local flowersFolder = island1 and island1:FindFirstChild("Flowers")
    if not flowersFolder then return end

    for _, item in ipairs(flowersFolder:GetChildren()) do
        if item.Name:lower():find("golden") then
            local primaryPart = item:IsA("Model") and (item.PrimaryPart or item:FindFirstChildWhichIsA("BasePart")) or (item:IsA("BasePart") and item)
            if goldenEnabled and primaryPart and isInRange(primaryPart) then 
                applyTag(item, Color3.fromRGB(230, 185, 95), Color3.fromRGB(250, 225, 170), "GoldenTag") 
            else 
                removeTag(item) 
            end
        end
    end
end

local function refreshFlowers()
    local targetFolder = Workspace:FindFirstChild("RunWorld")
    local island1 = targetFolder and targetFolder:FindFirstChild("Island1")
    local flowersFolder = island1 and island1:FindFirstChild("Flowers")
    if not flowersFolder then return end

