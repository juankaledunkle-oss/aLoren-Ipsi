RunService.RenderStepped:Connect(function(dt)
    -- 1. FPS Tracker
    local fps = dt > 0 and math.floor(1 / dt) or 60
    topBarFpsLabel.Text = "FPS: " .. fps
    topBarFpsLabel.TextColor3 = fps >= 50 and Color3.fromRGB(120, 255, 120) or (fps >= 30 and Color3.fromRGB(255, 230, 100) or Color3.fromRGB(255, 100, 100))

    -- 2. Player Stats Update
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local root = char and char:FindFirstChild("HumanoidRootPart")

    if statLabels["Name"] then
        statLabels["Name"].Text = LocalPlayer.Name
        statLabels["Health"].Text = hum and string.format("%d / %d", math.floor(hum.Health), math.floor(hum.MaxHealth)) or "N/A"
        
        local vel = root and root.AssemblyLinearVelocity or Vector3.new()
        statLabels["Speed (Studs/s)"].Text = string.format("%.1f studs/s", math.sqrt(vel.X * vel.X + vel.Z * vel.Z))
        statLabels["WalkSpeed"].Text = hum and tostring(math.floor(hum.WalkSpeed)) or "N/A"
        statLabels["JumpHeight"].Text = string.format("%.1f", hum and (hum.UseJumpPower and hum.JumpPower or hum.JumpHeight) or 0)
        statLabels["Status"].Text = hum and hum:GetState().Name or "Unknown"
        statLabels["Weight (kg)"].Text = string.format("%d kg", char and getModelMassKg(char) or 0)
    end

    -- 3. Ground Hover Logic
    if hoverEnabled and not flyEnabled and not FlingActive and root then
        raycastParams.FilterDescendantsInstances = {char}
        local rayResult = Workspace:Raycast(root.Position + Vector3.new(0, 3.8, 0), Vector3.new(0, -150, 0), raycastParams)
        if rayResult then
            local targetHeight = rayResult.Position.Y + 33.0
            if root.Position.Y < targetHeight or root.AssemblyLinearVelocity.Y < 1 then
                root.CFrame = CFrame.new(root.Position.X, targetHeight, root.Position.Z) * (root.CFrame - root.CFrame.Position)
                root.AssemblyLinearVelocity = Vector3.new(root.AssemblyLinearVelocity.X, 0, root.AssemblyLinearVelocity.Z)
            end
        end
    end
end)

