    if Physics.bv then pcall(function() Physics.bv:Destroy() end) end

    Physics.bg = Instance.new("BodyGyro", flyTargetPart)
    Physics.bg.P, Physics.bg.maxTorque = 9e4, Vector3.new(9e4, 9e4, 9e4)
    Physics.bg.cframe = flyTargetPart.CFrame

    Physics.bv = Instance.new("BodyVelocity", flyTargetPart)
    Physics.bv.Velocity, Physics.bv.MaxForce = Vector3.new(), Vector3.new(9e4, 9e4, 9e4)

    if Connections.fly then Connections.fly:Disconnect() end
    Connections.fly = trackConnection(RunService.RenderStepped:Connect(function()
        if State.isTerminated then stopFly() return end
        local currentHum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        local cam = getActiveCamera()
        if not currentHum or not cam then stopFly() return end

        local currentSeat = currentHum.SeatPart
        local activeTarget = currentSeat and (currentSeat.AssemblyRootPart or (currentSeat.Parent and currentSeat.Parent.PrimaryPart) or currentSeat) or getCharacterRoot(LocalPlayer.Character)
        if not activeTarget then return end

        if Physics.bv and Physics.bv.Parent ~= activeTarget then
            Physics.bv.Parent = activeTarget
            Physics.bg.Parent = activeTarget
        end

        Physics.bg.cframe = cam.CFrame
        local moveDir = Vector3.new()
        local moveVector = currentHum.MoveDirection

        if moveVector.Magnitude > 0 then
            local camCF = cam.CFrame
            local flatMove = camCF:VectorToObjectSpace(moveVector)
            moveDir = (camCF.LookVector * -flatMove.Z) + (camCF.RightVector * flatMove.X)
        end

        if UserInputService:IsKeyDown(Enum.KeyCode.W) then moveDir = moveDir + cam.CFrame.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then moveDir = moveDir - cam.CFrame.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then moveDir = moveDir - cam.CFrame.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then moveDir = moveDir + cam.CFrame.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) then moveDir = moveDir + Vector3.new(0, 1, 0) end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then moveDir = moveDir - Vector3.new(0, 1, 0) end

        if State.joystickEnabled and State.joystickDir.Magnitude > 0 then
            moveDir = moveDir + (cam.CFrame.RightVector * State.joystickDir.X) + (cam.CFrame.LookVector * -State.joystickDir.Y)
        end

        Physics.bv.Velocity = moveDir.Magnitude > 0 and moveDir.Unit * State.flySpeed or Vector3.new(0, 0.1, 0)
    end))
end

