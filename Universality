local function GetCategorizedTargets()
    local playerTargets, entityTargets = {}, {}
    local localChar = LocalPlayer.Character
    local localPos = (localChar and localChar:FindFirstChild("HumanoidRootPart")) and localChar.HumanoidRootPart.Position or Camera.CFrame.Position

    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("Humanoid") then
            local charModel = obj.Parent
            if charModel and charModel:IsA("Model") and charModel ~= localChar then
                local rootPart = charModel:FindFirstChild("HumanoidRootPart") or charModel:FindFirstChild("PrimaryPart") or charModel:FindFirstChildWhichIsA("BasePart")
                local dist = rootPart and (localPos - rootPart.Position).Magnitude or math.huge
                
                local targetData = { Name = charModel.Name .. " (" .. charModel.ClassName .. ")", Model = charModel, Humanoid = obj, Distance = dist }
                if Players:GetPlayerFromCharacter(charModel) then
                    table.insert(playerTargets, targetData)
                else
                    table.insert(entityTargets, targetData)
                end
            end
        end
    end
    
    local sortFunc = targetNearestEnabled and function(a, b) return a.Distance < b.Distance end or function(a, b) return a.Name:lower() < b.Name:lower() end
    table.sort(playerTargets, sortFunc)
    table.sort(entityTargets, sortFunc)
    
    return playerTargets, entityTargets
end

local function GetNearestSingleTarget()
    local pTargets, eTargets = GetCategorizedTargets()
    local all = {}
    for _, t in ipairs(pTargets) do table.insert(all, t) end
    for _, t in ipairs(eTargets) do table.insert(all, t) end
    table.sort(all, function(a, b) return a.Distance < b.Distance end)
    return all[1]
end

