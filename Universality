local function terminateScript()
    if State.isTerminated then return end
    State.isTerminated = true

    if stopFlingController then
        pcall(stopFlingController)
    else
        State.FlingActive = false
    end

    State.hoverEnabled = false
    State.flyEnabled = false
    State.swimEnabled = false
    State.seatedSwimEnabled = false
    State.spinEnabled = false
    State.noclipEnabled = false
    State.infJumpEnabled = false
    State.joystickEnabled = false
    State.humEspEnabled = false

    for _, conn in pairs(Connections) do
        if typeof(conn) == "RBXScriptConnection" then
            pcall(function() conn:Disconnect() end)
        end
    end
    table.clear(Connections)

    for _, obj in pairs(Physics) do
        if typeof(obj) == "Instance" then
            pcall(function() obj:Destroy() end)
        end
    end
    table.clear(Physics)

    for model, data in pairs(espCache) do
        if data then
            if data.Folder then pcall(function() data.Folder:Destroy() end) end
            if data.Highlight then pcall(function() data.Highlight:Destroy() end) end
        end
        espCache[model] = nil
    end

    pcall(function()
        Lighting.Brightness = originalLighting.Brightness
        Lighting.ClockTime = originalLighting.ClockTime
        Lighting.FogEnd = originalLighting.FogEnd
        Lighting.FogStart = originalLighting.FogStart
        Lighting.GlobalShadows = originalLighting.GlobalShadows
        Lighting.OutdoorAmbient = originalLighting.OutdoorAmbient
    end)

    pcall(function()
        LocalPlayer.CameraMaxZoomDistance = originalCameraSettings.CameraMaxZoomDistance
        LocalPlayer.CameraMinZoomDistance = originalCameraSettings.CameraMinZoomDistance
        LocalPlayer.CameraMode = originalCameraSettings.CameraMode
        local cam = getActiveCamera()
        if cam then
            cam.CameraType = Enum.CameraType.Custom
            cam.CameraSubject = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        end
    end)

    pcall(function()
        Workspace.FallenPartsDestroyHeight = env.FPDH
    end)

    pcall(function()
        if screenGui then screenGui:Destroy() end
    end)

    destroyAllExistingGuis()

    if env.CultOfEntropyInstance and env.CultOfEntropyInstance.Id == State then
        env.CultOfEntropyInstance = nil
    end
    if env.CultOfEntropyFling and env.CultOfEntropyFling.Id == State then
        env.CultOfEntropyFling = nil
    end
end

