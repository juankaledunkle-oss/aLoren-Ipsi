local function getESPColor(model)
    local player = Players:GetPlayerFromCharacter(model)
    if player then
        if player.Team and player.Team.TeamColor then return player.Team.TeamColor.Color end
        return COLOR_PLAYER_DEFAULT
    else
        local tc = model:FindFirstChild("TeamColor")
        if tc and typeof(tc.Value) == "Color3" then return tc.Value end
        return COLOR_NPC_DEFAULT
    end
end

local function getModelMassKg(model)
    local totalMass = 0
    for _, part in ipairs(model:GetDescendants()) do
        if part:IsA("BasePart") then totalMass = totalMass + part.AssemblyMass end
    end
    return math.floor(totalMass)
end

