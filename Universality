local function startSwim()
    local char = LocalPlayer.Character
    local root = getCharacterRoot(char)
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not root or not hum then return end

    pcall(function()
        hum:SetStateEnabled(Enum.HumanoidStateType.Swimming, true)
        hum:ChangeState(Enum.HumanoidStateType.Swimming)
    end)

    if Physics.swimBv then pcall(function() Physics.swimBv:Destroy() end) end
    Physics.swimBv = Instance.new("BodyVelocity")
    Physics.swimBv.MaxForce = Vector3.new(9e4, 9e4, 9e4)
    Physics.swimBv.Velocity = Vector3.new(0, 0, 0)
    Physics.swimBv.Parent = root

    if Connections.swim then Connections.swim:Disconnect() end
    Connections.swim = trackConnection(RunService.Heartbeat:Connect(function()
        if State.isTerminated then return end
        local currentChar = LocalPlayer.Character
        local currentHum = currentChar and currentChar:FindFirstChildOfClass("Humanoid")
        local currentRoot = getCharacterRoot(currentChar)
        local cam = getActiveCamera()
        if not currentHum or not currentRoot or not cam then return end

        pcall(function()
            if currentHum:GetState() ~= Enum.HumanoidStateType.Swimming then
                currentHum:ChangeState(Enum.HumanoidStateType.Swimming)
            end
        end)

        if State.FlingActive then
            if Physics.swimBv then Physics.swimBv.MaxForce = Vector3.new(0, 0, 0) end
            return
        end

        if not Physics.swimBv or Physics.swimBv.Parent ~= currentRoot then
            if Physics.swimBv then pcall(function() Physics.swimBv:Destroy() end) end
            Physics.swimBv = Instance.new("BodyVelocity")
            Physics.swimBv.Parent = currentRoot
        end
        Physics.swimBv.MaxForce = Vector3.new(9e4, 9e4, 9e4)

        local moveDir = Vector3.new()
        local moveVector = currentHum.MoveDirection
        if moveVector.Magnitude > 0 then
            local camCF = cam.CFrame
            local flatMove = camCF:VectorToObjectSpace(moveVector)
            moveDir = (camCF.LookVector * -flatMove.Z) + (camCF.RightVector * flatMove.X)
        end

        if UserInputService:IsKeyDown(Enum.KeyCode.W) then moveDir = moveDir + cam.CFrame.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then moveDir = moveDir - cam.CFrame.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then moveDir = moveDir - cam.CFrame.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then moveDir = moveDir + cam.CFrame.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) then moveDir = moveDir + Vector3.new(0, 1, 0) end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then moveDir = moveDir - Vector3.new(0, 1, 0) end

        if State.joystickEnabled and State.joystickDir.Magnitude > 0 then
            moveDir = moveDir + (cam.CFrame.RightVector * State.joystickDir.X) + (cam.CFrame.LookVector * -State.joystickDir.Y)
        end

        if moveDir.Magnitude > 0 then
            Physics.swimBv.Velocity = moveDir.Unit * currentHum.WalkSpeed
        else
            Physics.swimBv.Velocity = State.cachedWaterCount > 0 and Vector3.new(0, -2, 0) or Vector3.new(0, 0, 0)
        end
    end))
end

