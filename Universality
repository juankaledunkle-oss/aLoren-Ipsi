noTextureButton.MouseButton1Click:Connect(function()
    if noTextureEnabled then
        noTextureEnabled = false
        noTextureClickStep = 0
        noTextureButton.Text = "No Texture: OFF"
        noTextureButton.BackgroundColor3 = Color3.fromRGB(28, 35, 45)
        stopNoTexture()
    else
        noTextureClickStep = noTextureClickStep + 1
        noTextureTick = tick()

        if noTextureClickStep == 1 then
            noTextureButton.Text = "Are you sure?"
            noTextureButton.BackgroundColor3 = Color3.fromRGB(25, 65, 95)
        elseif noTextureClickStep == 2 then
            noTextureButton.Text = "Are you REALLY sure?"
            noTextureButton.BackgroundColor3 = Color3.fromRGB(30, 80, 120)
        elseif noTextureClickStep == 3 then
            noTextureButton.Text = "Are you REALLY REALLY SURE?"
            noTextureButton.BackgroundColor3 = Color3.fromRGB(35, 100, 150)
        elseif noTextureClickStep >= 4 then
            noTextureEnabled = true
            noTextureClickStep = 0
            noTextureButton.Text = "No Texture: ON"
            noTextureButton.BackgroundColor3 = Color3.fromRGB(25, 75, 110)
            startNoTexture()
            return
        end

        local currentStepToken = noTextureClickStep
        task.spawn(function()
            task.wait(1)
            if not noTextureEnabled and noTextureClickStep == currentStepToken and (tick() - noTextureTick) >= 1 then
                for i = 1, 10 do
                    if noTextureClickStep ~= currentStepToken or noTextureEnabled then break end
                    noTextureButton.TextTransparency = i / 10
                    noTextureButton.TextColor3 = Color3.fromRGB(
                        math.floor(180 * (1 - (i/10 * 0.5))),
                        math.floor(210 * (1 - (i/10 * 0.5))),
                        math.floor(255 * (1 - (i/10 * 0.5)))
                    )
                    task.wait(0.04)
                end

                if noTextureClickStep == currentStepToken and not noTextureEnabled then
                    noTextureClickStep = 0
                    noTextureButton.Text = "No Texture: OFF"
                    noTextureButton.BackgroundColor3 = Color3.fromRGB(28, 35, 45)
                    noTextureButton.TextTransparency = 0
                    noTextureButton.TextColor3 = Color3.fromRGB(180, 210, 255)
                end
            end
        end)
    end
end)

