local function destroyExistingGuiInContainer(parent)
    if not parent then return end
    pcall(function()
        for _, child in ipairs(parent:GetChildren()) do
            if child.Name == "RayfieldStyleGui" or child.Name == "ESPContainerFolder" then
                child:Destroy()
            end
        end
    end)
end

local function destroyAllExistingGuis()
    destroyExistingGuiInContainer(guiParent)
    destroyExistingGuiInContainer(CoreGui)
    pcall(function()
        local pg = LocalPlayer:FindFirstChildOfClass("PlayerGui")
        destroyExistingGuiInContainer(pg)
    end)
    pcall(function()
        for _, obj in ipairs(Workspace:GetDescendants()) do
            if obj.Name == "UniversalBodyPartHighlight" then
                obj:Destroy()
            end
        end
    end)
end

