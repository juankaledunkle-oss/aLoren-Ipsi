local function updateJoystickPos(inputPos)
    local center = joystickFrame.AbsolutePosition + (joystickFrame.AbsoluteSize / 2)
    local delta = inputPos - center
    local maxRadius = joystickFrame.AbsoluteSize.X / 2
    if delta.Magnitude > maxRadius then delta = delta.Unit * maxRadius end

    joystickThumb.Position = UDim2.new(0.5, delta.X - 25, 0.5, delta.Y - 25)
    joystickDir = Vector2.new(delta.X / maxRadius, -delta.Y / maxRadius)
end

joystickFrame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
