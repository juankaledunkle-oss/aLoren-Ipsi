local cachedWaterCount = 0
local function isWaterPart(obj)
    if not obj:IsA("BasePart") then return false end
    if obj.Material == Enum.Material.Water then return true end
    local lowerName = obj.Name:lower()
    return string.find(lowerName, "water", 1, true) ~= nil
        or string.find(lowerName, "fluid", 1, true) ~= nil
        or string.find(lowerName, "ocean", 1, true) ~= nil
        or string.find(lowerName, "sea", 1, true) ~= nil
end

