local function updateJoystickPos(inputPos)
    local center = joystickFrame.AbsolutePosition + (joystickFrame.AbsoluteSize / 2)
    local delta = inputPos - center
    local maxRadius = joystickFrame.AbsoluteSize.X / 2
    local dist = delta.Magnitude

    if dist > maxRadius then
        delta = delta.Unit * maxRadius
    end

    joystickThumb.Position = UDim2.new(0.5, delta.X - 25, 0.5, delta.Y - 25)
    joystickDir = Vector2.new(delta.X / maxRadius, -delta.Y / maxRadius)
end

joystickFrame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        joystickDragging = true
        updateJoystickPos(Vector2.new(input.Position.X, input.Position.Y))
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if joystickDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        updateJoystickPos(Vector2.new(input.Position.X, input.Position.Y))
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        joystickDragging = false
        joystickThumb.Position = UDim2.new(0.5, -25, 0.5, -25)
        joystickDir = Vector2.new(0, 0)
    end
end)

local function startJoystick()
    joystickFrame.Visible = true
    if joystickConnection then joystickConnection:Disconnect() end
    joystickConnection = RunService.RenderStepped:Connect(function()
        if not joystickEnabled or flyEnabled then return end
        local char = LocalPlayer.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if hum and joystickDir.Magnitude > 0 then
            local camCF = Camera.CFrame
            local moveDir = (camCF.RightVector * joystickDir.X) + (camCF.LookVector * joystickDir.Y)
            moveDir = Vector3.new(moveDir.X, 0, moveDir.Z).Unit
            hum:Move(moveDir, false)
        end
    end)
end

local function stopJoystick()
    joystickFrame.Visible = false
    joystickDir = Vector2.new(0, 0)
    joystickDragging = false
    joystickThumb.Position = UDim2.new(0.5, -25, 0.5, -25)
