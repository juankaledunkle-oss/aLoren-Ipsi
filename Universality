        "Final incantation... End it now. (9/10)"
    }

    killScriptButton.MouseButton1Click:Connect(function()
        local currentTime = tick()
        if currentTime - lastKillClickTime > 0.8 then killClickCount = 0 end
        lastKillClickTime = currentTime
        killClickCount = killClickCount + 1
        local currentKillId = killClickCount

        task.delay(0.8, function()
            if killClickCount == currentKillId and killClickCount < 10 then
                killClickCount = 0
                killScriptButton.Text = "Purge & Terminate Script"
                killScriptButton.BackgroundColor3 = Color3.fromRGB(22, 16, 20)
