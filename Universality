local function startFly()
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not char or not hum then return end
    
    local seatPart = hum.SeatPart
    local flyTargetPart = seatPart and (seatPart.AssemblyRootPart or seatPart.Parent.PrimaryPart or seatPart) or char:FindFirstChild("HumanoidRootPart")
    if not flyTargetPart then return end
    
    if not seatPart then hum.PlatformStand = true end
    
    if Physics.bg then Physics.bg:Destroy() end
    if Physics.bv then Physics.bv:Destroy() end
    
    Physics.bg = Instance.new("BodyGyro", flyTargetPart)
    Physics.bg.P, Physics.bg.maxTorque = 9e4, Vector3.new(9e4, 9e4, 9e4)
    Physics.bg.cframe = flyTargetPart.CFrame
    
    Physics.bv = Instance.new("BodyVelocity", flyTargetPart)
    Physics.bv.Velocity, Physics.bv.MaxForce = Vector3.new(), Vector3.new(9e4, 9e4, 9e4)

    if Connections.fly then Connections.fly:Disconnect() end
    Connections.fly = RunService.RenderStepped:Connect(function()
        local currentHum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if not currentHum then stopFly() return end
        
        local currentSeat = currentHum.SeatPart
        local activeTarget = currentSeat and (currentSeat.AssemblyRootPart or currentSeat.Parent.PrimaryPart or currentSeat) or (LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart"))
        if not activeTarget then return end
        
        if Physics.bv and Physics.bv.Parent ~= activeTarget then
            Physics.bv.Parent = activeTarget
            Physics.bg.Parent = activeTarget
        end

        Physics.bg.cframe = Camera.CFrame
        local moveDir = Vector3.new()
        local moveVector = currentHum.MoveDirection
        
        if moveVector.Magnitude > 0 then
            local camCF = Camera.CFrame
            local flatMove = camCF:VectorToObjectSpace(moveVector)
            moveDir = (camCF.LookVector * -flatMove.Z) + (camCF.RightVector * flatMove.X)
        end

        if UserInputService:IsKeyDown(Enum.KeyCode.W) then moveDir = moveDir + Camera.CFrame.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then moveDir = moveDir - Camera.CFrame.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then moveDir = moveDir - Camera.CFrame.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then moveDir = moveDir + Camera.CFrame.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) then moveDir = moveDir + Vector3.new(0, 1, 0) end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then moveDir = moveDir - Vector3.new(0, 1, 0) end

        if State.joystickEnabled and State.joystickDir.Magnitude > 0 then
            moveDir = moveDir + (Camera.CFrame.RightVector * State.joystickDir.X) + (Camera.CFrame.LookVector * -State.joystickDir.Y)
        end

        Physics.bv.Velocity = moveDir.Magnitude > 0 and moveDir.Unit * State.flySpeed or Vector3.new(0, 0.1, 0)
    end)
end

stopFly = function()
    if Connections.fly then Connections.fly:Disconnect() Connections.fly = nil end
    local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
    if hum then hum.PlatformStand = false end
    if Physics.bg then Physics.bg:Destroy() Physics.bg = nil end
    if Physics.bv then Physics.bv:Destroy() Physics.bv = nil end
end

