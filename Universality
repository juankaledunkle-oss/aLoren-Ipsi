        elseif noTextureClickStep == 2 then noTextureButton.Text, noTextureButton.BackgroundColor3 = "Are you REALLY sure?", Color3.fromRGB(30, 80, 120)
        elseif noTextureClickStep >= 3 then
            noTextureEnabled, noTextureClickStep = true, 0
            noTextureButton.Text, noTextureButton.BackgroundColor3 = "No Texture: ON", Color3.fromRGB(25, 75, 110)
            startNoTexture()
        end
    end
end)

