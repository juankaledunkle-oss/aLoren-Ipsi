local cornersBuffer = table.create(8)
RunService.RenderStepped:Connect(function()
    if not humEspEnabled then return end

    local localChar = LocalPlayer.Character
    local localRoot = localChar and localChar:FindFirstChild("HumanoidRootPart")
    local localPos = localRoot and localRoot.Position or Camera.CFrame.Position

    for model, data in pairs(espCache) do
        local hum = model:FindFirstChildOfClass("Humanoid")
        local rootPart = model:FindFirstChild("HumanoidRootPart") or model:FindFirstChild("PrimaryPart") or model:FindFirstChildWhichIsA("BasePart")

        if model.Parent and hum and rootPart and hum.Health > 0 then
            local espColor = getESPColor(model)
            if data.Highlight.FillColor ~= espColor then
                data.Highlight.FillColor = espColor
                data.Highlight.OutlineColor = espColor
                data.NameLabel.TextColor3 = espColor
                for _, line in ipairs(data.BoxLines) do line.BackgroundColor3 = espColor end
            end

            data.Highlight.Enabled = true

            local cf, size = model:GetBoundingBox()
            cf = cf + Vector3.new(0, 2, 0)
            local hX, hY, hZ = size.X/2, size.Y/2, size.Z/2

            cornersBuffer[1] = cf * Vector3.new(-hX, -hY, -hZ)
            cornersBuffer[2] = cf * Vector3.new(hX, -hY, -hZ)
            cornersBuffer[3] = cf * Vector3.new(hX, hY, -hZ)
            cornersBuffer[4] = cf * Vector3.new(-hX, hY, -hZ)
            cornersBuffer[5] = cf * Vector3.new(-hX, -hY, hZ)
            cornersBuffer[6] = cf * Vector3.new(hX, -hY, hZ)
            cornersBuffer[7] = cf * Vector3.new(hX, hY, hZ)
            cornersBuffer[8] = cf * Vector3.new(-hX, -hY, hZ)

            local minX, minY = math.huge, math.huge
            local maxX, maxY = -math.huge, -math.huge
            local onScreenCount = 0

            for i = 1, 8 do
                local screenPos, onScreen = Camera:WorldToViewportPoint(cornersBuffer[i])
                if onScreen then onScreenCount = onScreenCount + 1 end
                if screenPos.X < minX then minX = screenPos.X end
                if screenPos.X > maxX then maxX = screenPos.X end
                if screenPos.Y < minY then minY = screenPos.Y end
                if screenPos.Y > maxY then maxY = screenPos.Y end
            end

            if onScreenCount > 0 then
                local boxW, boxH = maxX - minX, maxY - minY
                local lines = data.BoxLines

                lines[1].Size = UDim2.new(0, boxW, 0, 1.5)
                lines[1].Position = UDim2.new(0, minX, 0, minY)
                lines[1].Visible = true

                lines[2].Size = UDim2.new(0, boxW, 0, 1.5)
                lines[2].Position = UDim2.new(0, minX, 0, maxY)
                lines[2].Visible = true

                lines[3].Size = UDim2.new(0, 1.5, 0, boxH)
                lines[3].Position = UDim2.new(0, minX, 0, minY)
                lines[3].Visible = true

                lines[4].Size = UDim2.new(0, 1.5, 0, boxH)
                lines[4].Position = UDim2.new(0, maxX, 0, minY)
                lines[4].Visible = true

                data.NameLabel.Position = UDim2.new(0, minX + (boxW / 2), 0, minY - 4)
                data.NameLabel.Text = string.format("%s | HP: %d | %dkg | %dm", model.Name, math.floor(hum.Health), getModelMassKg(model), math.floor((localPos - rootPart.Position).Magnitude))
                data.NameLabel.Visible = true

                local healthPercent = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
                data.HealthBarBg.Size = UDim2.new(0, 3, 0, boxH)
                data.HealthBarBg.Position = UDim2.new(0, minX - 6, 0, minY)
                data.HealthBarFill.Size = UDim2.new(1, 0, healthPercent, 0)
                data.HealthBarFill.Position = UDim2.new(0, 0, 1 - healthPercent, 0)
                data.HealthBarBg.Visible = true
            else
                for _, line in ipairs(data.BoxLines) do line.Visible = false end
                data.NameLabel.Visible = false
                data.HealthBarBg.Visible = false
            end
        else
            data.Highlight.Enabled = false
            for _, line in ipairs(data.BoxLines) do line.Visible = false end
            data.NameLabel.Visible = false
            data.HealthBarBg.Visible = false
        end
    end
end)

