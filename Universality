            statLabels["WalkSpeed"].Text = hum and tostring(math.floor(hum.WalkSpeed)) or "N/A"
            local jumpVal = 0
            if hum then
                local ok, val = pcall(function() return hum.UseJumpPower and hum.JumpPower or hum.JumpHeight end)
                jumpVal = ok and (val or 0) or (hum.JumpPower or 0)
            end
            statLabels["JumpHeight"].Text = string.format("%.1f", jumpVal)
            local stateName = "Unknown"
            if hum then
