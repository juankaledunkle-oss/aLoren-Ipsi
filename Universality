local function GetModelMass(model)
    local totalMass = 0
    for _, part in ipairs(model:GetDescendants()) do
        if part:IsA("BasePart") then totalMass = totalMass + part.AssemblyMass end
    end
    return math.max(totalMass, 1)
end

-- ================= NATIVE CAMERA SUBJECT TRACKING & MAXIMUM VELOCITY SPIN-FLING =================
local orbitAngleCounter = 0

local function SkidSelectionAxisFlingModel(TargetData)
    local Character = LocalPlayer.Character
    local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")
    local RootPart = Humanoid and Humanoid.RootPart
    local TCharacter = TargetData.Model
    
    if not TCharacter or not TCharacter.Parent then return end
    
    local THumanoid = TargetData.Humanoid
    local TRootPart = THumanoid and THumanoid.RootPart
    local THead = TCharacter:FindFirstChild("Head")
    local Accessory = TCharacter:FindFirstChildOfClass("Accessory")
    local Handle = Accessory and Accessory:FindFirstChild("Handle")
    local targetPart = TRootPart or THead or Handle or TCharacter:FindFirstChildWhichIsA("BasePart")
    
    if targetPart then
        Camera.CameraType = Enum.CameraType.Custom
        LocalPlayer.CameraMaxZoomDistance = 999999
        Camera.CameraSubject = targetPart
    end
    
    if Character and Humanoid and RootPart then
        if not getgenv().OldPos or RootPart.Velocity.Magnitude < 50 then
            getgenv().OldPos = RootPart.CFrame
        end
        
        if THumanoid and THumanoid.Sit then return end
        local baseTargetPart = TCharacter:FindFirstChildWhichIsA("BasePart")
        if not baseTargetPart then return end
        
        local exponentialMultiplier = math.clamp(math.pow(GetModelMass(TCharacter), 1.3), 1, 50)
        
        local FPosAxis = function(BasePart)
            local selectedMode = FlingDirections[currentDirIndex]
            local velocityTarget = Vector3.new()
            
            orbitAngleCounter = orbitAngleCounter + orbitSpeed
            local orbitRadius = 1.2
            local offsetX = math.cos(orbitAngleCounter) * orbitRadius
            local offsetZ = math.sin(orbitAngleCounter) * orbitRadius
            
            local actualTargetPos = TRootPart and TRootPart.Position or BasePart.Position
            local targetVelocity = TRootPart and TRootPart.AssemblyLinearVelocity or Vector3.new()
            
            local predictedPos = actualTargetPos
            if movementPredictorEnabled and targetVelocity.Magnitude > 0.1 then
                local dist = (RootPart.Position - actualTargetPos).Magnitude
                local dynamicLead = math.clamp(dist / 50 * 0.4, 0.1, 0.5) * math.min(targetVelocity.Magnitude / 16, 2)
                predictedPos = actualTargetPos + (targetVelocity * dynamicLead)
            end
            
            local orbitalOffset = Vector3.new(offsetX, 0.5, offsetZ)
            local targetDestPos = predictedPos + orbitalOffset
            
            if selectedMode == "Upward" then
                velocityTarget = Vector3.new(0, 1.5e9, 0) * exponentialMultiplier
            elseif selectedMode == "Downward" then
                velocityTarget = Vector3.new(0, -1.5e9, 0) * exponentialMultiplier
            elseif selectedMode == "Random" then
                velocityTarget = Vector3.new(math.random(-1.5e9, 1.5e9), math.random(-1.5e9, 1.5e9), math.random(-1.5e9, 1.5e9))
            end
            
            local maxSpinAngle = tick() * spinSpeed
            local faceCFrame = CFrame.new(targetDestPos) * CFrame.Angles(maxSpinAngle, maxSpinAngle * 1.5, maxSpinAngle * 0.8)

            RootPart.CFrame = faceCFrame
            Character:SetPrimaryPartCFrame(faceCFrame)
            RootPart.Velocity = velocityTarget
            RootPart.RotVelocity = Vector3.new(1.5e9, 1.5e9, 1.5e9)
        end
        
        local SFBasePart = function(BasePart)
            local Time = tick()
            repeat
                if RootPart and THumanoid then
                    if Humanoid:GetState() ~= Enum.HumanoidStateType.Swimming then
                        Humanoid:SetStateEnabled(Enum.HumanoidStateType.Swimming, true)
                        Humanoid:ChangeState(Enum.HumanoidStateType.Swimming)
                    end
                    FPosAxis(BasePart)
                    task.wait()
                end
            until Time + 2 < tick() or not FlingActive
        end
        
        workspace.FallenPartsDestroyHeight = 0/0
        local BV = Instance.new("BodyVelocity")
        BV.Parent = RootPart
        BV.Velocity = Vector3.new()
        BV.MaxForce = Vector3.new(9e9, 9e9, 9e9)
        
        Humanoid:SetStateEnabled(Enum.HumanoidStateType.Seated, false)
        Humanoid:SetStateEnabled(Enum.HumanoidStateType.Swimming, true)
        Humanoid:ChangeState(Enum.HumanoidStateType.Swimming)
        
        if flingSwimBv then flingSwimBv:Destroy() end
        flingSwimBv = Instance.new("BodyVelocity")
        flingSwimBv.MaxForce = Vector3.new(9e4, 9e4, 9e4)
        flingSwimBv.Velocity = Vector3.new(0, 0, 0)
        flingSwimBv.Parent = RootPart
        
        SFBasePart(targetPart)
        
        if flingSwimBv then flingSwimBv:Destroy() flingSwimBv = nil end
        BV:Destroy()
        Humanoid:SetStateEnabled(Enum.HumanoidStateType.Seated, true)
        Humanoid:SetStateEnabled(Enum.HumanoidStateType.Swimming, false)
        Humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
    end
end

local function ReturnToOriginalPosition()
    if flingSwimBv then flingSwimBv:Destroy() flingSwimBv = nil end
    local character = LocalPlayer.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local rootPart = humanoid and humanoid.RootPart
    
    if character and rootPart and getgenv().OldPos then
        local startTime = tick()
        repeat
            rootPart.CFrame = getgenv().OldPos * CFrame.new(0, 0.5, 0)
            character:SetPrimaryPartCFrame(getgenv().OldPos * CFrame.new(0, 0.5, 0))
            humanoid:ChangeState("GettingUp")
            for _, part in pairs(character:GetChildren()) do
                if part:IsA("BasePart") then part.Velocity, part.RotVelocity = Vector3.new(), Vector3.new() end
            end
            task.wait()
        until (rootPart.Position - getgenv().OldPos.p).Magnitude < 15 or (tick() - startTime) > 2
        
        workspace.FallenPartsDestroyHeight = getgenv().FPDH
    end

    Camera.CameraType = Enum.CameraType.Custom
    Camera.CameraSubject = humanoid
end

