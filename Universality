local function startNoTexture()
    if noTextureConnection then noTextureConnection:Disconnect() end
    
    local function cleanPart(obj)
        if obj:IsA("BasePart") then
            obj.Material = Enum.Material.SmoothPlastic
            obj.Reflectance = 0
        elseif obj:IsA("Decal") or obj:IsA("Texture") then
            obj.Transparency = 1
        elseif obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Fire") or obj:IsA("Smoke") or obj:IsA("Sparkles") then
            obj.Enabled = false
        end
    end

    pcall(function()
        for _, obj in ipairs(Workspace:GetDescendants()) do
            cleanPart(obj)
        end
        Lighting.GlobalShadows = false
        Lighting.FogEnd = 9e9
    end)
    
    noTextureConnection = Workspace.DescendantAdded:Connect(function(obj)
        pcall(function() cleanPart(obj) end)
    end)
end

local function stopNoTexture()
    if noTextureConnection then noTextureConnection:Disconnect() noTextureConnection = nil end
    Lighting.GlobalShadows = originalLighting.GlobalShadows
    Lighting.FogEnd = originalLighting.FogEnd
end

