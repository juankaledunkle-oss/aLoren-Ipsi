local function GetModelMass(model)
    local totalMass = 0
    for _, part in ipairs(model:GetDescendants()) do
        if part:IsA("BasePart") then
            totalMass = totalMass + part.AssemblyMass
        end
    end
    return math.max(totalMass, 1)
end

local function SkidSelectionAxisFlingModel(TargetData)
    local Character = LocalPlayer.Character
    local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")
    local RootPart = Humanoid and Humanoid.RootPart
    local TCharacter = TargetData.Model
    
    if not TCharacter or not TCharacter.Parent then return end
    
    local THumanoid = TargetData.Humanoid
    local TRootPart = THumanoid and THumanoid.RootPart
    local THead = TCharacter:FindFirstChild("Head")
    local Accessory = TCharacter:FindFirstChildOfClass("Accessory")
    local Handle = Accessory and Accessory:FindFirstChild("Handle")
    
    if Character and Humanoid and RootPart then
        if not getgenv().OldPos or RootPart.Velocity.Magnitude < 50 then
            getgenv().OldPos = RootPart.CFrame
        end
        
        if THumanoid and THumanoid.Sit then return end
        
        if not TCharacter:FindFirstChildWhichIsA("BasePart") then return end
        
        local targetMass = GetModelMass(TCharacter)
        local exponentialMultiplier = math.clamp(math.pow(targetMass, 1.3), 1, 50)
        
        local predictedPos = TRootPart and TRootPart.Position or RootPart.Position
        
        local FPosAxis = function(BasePart, stepOffset)
            local lookVector = RootPart.CFrame.LookVector
            local rightVector = RootPart.CFrame.RightVector
            local selectedMode = FlingDirections[currentDirIndex]
            
            local velocityTarget = Vector3.new()
            local cframeOffset = Vector3.new()

            local staggerScale = 2.5
            local staggerX = (math.random() > 0.5 and 1 or -1) * (math.random(10, 30) / 10) * staggerScale
            local staggerZ = (math.random() > 0.5 and 1 or -1) * (math.random(10, 30) / 10) * staggerScale
            local horizontalStagger = (rightVector * staggerX) + (lookVector * staggerZ)

            if selectedMode == "Upward" then
                velocityTarget = (Vector3.new(0, stepOffset > 0 and 9e8 or -3e8, 0) + horizontalStagger * 1e7) * exponentialMultiplier
                cframeOffset = Vector3.new(0, stepOffset, 0) + horizontalStagger
            elseif selectedMode == "Downward" then
                velocityTarget = (Vector3.new(0, stepOffset > 0 and -9e8 or 3e8, 0) + horizontalStagger * 1e7) * exponentialMultiplier
                cframeOffset = Vector3.new(0, stepOffset, 0) + horizontalStagger
            elseif selectedMode == "Random" then
                velocityTarget = Vector3.new(math.random(-9e8, 9e8), math.random(-9e8, 9e8), math.random(-9e8, 9e8))
                cframeOffset = Vector3.new(math.random(-2, 2), math.random(-2, 2), math.random(-2, 2))
            end
            
            local actualTargetPos = TRootPart and TRootPart.Position or BasePart.Position
            local targetVelocity = TRootPart and TRootPart.AssemblyLinearVelocity or Vector3.new(0, 0, 0)
            
            local rawPrediction = actualTargetPos + (targetVelocity * 0.25)
            predictedPos = predictedPos:Lerp(rawPrediction, 0.15)
            
            local flattenedTargetPos = Vector3.new(predictedPos.X, BasePart.Position.Y, predictedPos.Z)
            
            local dirToTarget = (flattenedTargetPos - BasePart.Position)
            if dirToTarget.Magnitude > 0.01 then
                dirToTarget = dirToTarget.Unit
            else
                dirToTarget = Vector3.new(0, 0, -1)
            end

            local spinOffset = math.sin(tick() * 45) * 0.5
            local baseFaceCFrame = CFrame.lookAt(BasePart.Position + cframeOffset, BasePart.Position + cframeOffset + dirToTarget)
            local faceCFrame = baseFaceCFrame * CFrame.Angles(0, math.rad(100) + spinOffset, 0)

            RootPart.CFrame = faceCFrame
            Character:SetPrimaryPartCFrame(faceCFrame)
            RootPart.Velocity = velocityTarget
            RootPart.RotVelocity = Vector3.new(9e8, 9e8, 9e8)

            if TRootPart then
                local currentLook = Camera.CFrame.LookVector
                local focusOffset = TRootPart.Position + Vector3.new(0, 3, 0)
                Camera.CFrame = CFrame.new(focusOffset - (currentLook * 12), focusOffset)
            end
        end
        
        local SFBasePart = function(BasePart)
            local TimeToWait = 2
            local Time = tick()
            repeat
                if RootPart and THumanoid then
                    FPosAxis(BasePart, 2.0)
                    task.wait()
                    FPosAxis(BasePart, -2.0)
                    task.wait()
                end
            until Time + TimeToWait < tick() or not FlingActive
        end
        
        workspace.FallenPartsDestroyHeight = 0/0
        
        local BV = Instance.new("BodyVelocity")
        BV.Parent = RootPart
        BV.Velocity = Vector3.new(0, 0, 0)
        BV.MaxForce = Vector3.new(9e9, 9e9, 9e9)
        
        Humanoid:SetStateEnabled(Enum.HumanoidStateType.Seated, false)
        Humanoid:SetStateEnabled(Enum.HumanoidStateType.Swimming, true)
        Humanoid:ChangeState(Enum.HumanoidStateType.Swimming)
        
        if TRootPart then
            SFBasePart(TRootPart)
        elseif THead then
            SFBasePart(THead)
        elseif Handle then
            SFBasePart(Handle)
        end
        
        BV:Destroy()
        Humanoid:SetStateEnabled(Enum.HumanoidStateType.Seated, true)
        Humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
    end
end

local function ReturnToOriginalPosition()
    local character = LocalPlayer.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local rootPart = humanoid and humanoid.RootPart
    
    if character and rootPart and getgenv().OldPos then
        local startTime = tick()
        repeat
            rootPart.CFrame = getgenv().OldPos * CFrame.new(0, 0.5, 0)
            character:SetPrimaryPartCFrame(getgenv().OldPos * CFrame.new(0, 0.5, 0))
            humanoid:ChangeState("GettingUp")
            for _, part in pairs(character:GetChildren()) do
                if part:IsA("BasePart") then
                    part.Velocity, part.RotVelocity = Vector3.new(), Vector3.new()
                end
            end
            task.wait()
        until (rootPart.Position - getgenv().OldPos.p).Magnitude < 15 or (tick() - startTime) > 2
        
        workspace.FallenPartsDestroyHeight = getgenv().FPDH
    end
end

