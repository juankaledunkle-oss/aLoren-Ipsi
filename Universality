                data.Highlight.FillColor = espColor
                data.Highlight.OutlineColor = espColor
                data.NameLabel.TextColor3 = espColor
                data.HighlightInfoLabel.TextColor3 = espColor
                for _, line in ipairs(data.BoxLines) do
                    line.BackgroundColor3 = espColor
                end
            end

            local distance = math.floor((localPos - rootPart.Position).Magnitude)
            local healthVal = math.floor(hum.Health)
            local maxHealthVal = math.floor(hum.MaxHealth)

            if highlightEspEnabled then
                data.Highlight.Enabled = true
                data.HighlightBillboard.Enabled = true
                data.HighlightInfoLabel.Text = string.format("%s\nHP: %d/%d | [%dm]", model.Name, healthVal, maxHealthVal, distance)
            else
                data.Highlight.Enabled = false
                data.HighlightBillboard.Enabled = false
            end

            if humEspEnabled then
                local cf, size = model:GetBoundingBox()
                -- Shift bounding box 2 studs upward relative to the model center
                cf = cf + Vector3.new(0, 2, 0)
                
                local corners = {
                    cf * Vector3.new(-size.X/2, -size.Y/2, -size.Z/2),
                    cf * Vector3.new(size.X/2, -size.Y/2, -size.Z/2),
                    cf * Vector3.new(size.X/2, size.Y/2, -size.Z/2),
                    cf * Vector3.new(-size.X/2, size.Y/2, -size.Z/2),
                    cf * Vector3.new(-size.X/2, -size.Y/2, size.Z/2),
                    cf * Vector3.new(size.X/2, -size.Y/2, size.Z/2),
                    cf * Vector3.new(size.X/2, size.Y/2, size.Z/2),
                    cf * Vector3.new(-size.X/2, size.Y/2, size.Z/2),
                }

                local screenCorners = {}
                local onScreenCount = 0
                for i, v in ipairs(corners) do
                    local screenPos, onScreen = Camera:WorldToViewportPoint(v)
                    screenCorners[i] = Vector2.new(screenPos.X, screenPos.Y)
                    if onScreen then onScreenCount = onScreenCount + 1 end
                end

                if onScreenCount > 0 then
                    local minX, minY = math.huge, math.huge
                    local maxX, maxY = -math.huge, -math.huge
                    for _, sc in ipairs(screenCorners) do
                        if sc.X < minX then minX = sc.X end
                        if sc.X > maxX then maxX = sc.X end
                        if sc.Y < minY then minY = sc.Y end
                        if sc.Y > maxY then maxY = sc.Y end
                    end

                    local boxW = maxX - minX
                    local boxH = maxY - minY
                    local thickness = 1.5
                    local lines = data.BoxLines
                    
                    lines[1].Size = UDim2.new(0, boxW, 0, thickness)
                    lines[1].Position = UDim2.new(0, minX, 0, minY)
                    lines[1].Visible = true
                    
                    lines[2].Size = UDim2.new(0, boxW, 0, thickness)
                    lines[2].Position = UDim2.new(0, minX, 0, maxY)
                    lines[2].Visible = true
                    
                    lines[3].Size = UDim2.new(0, thickness, 0, boxH)
                    lines[3].Position = UDim2.new(0, minX, 0, minY)
                    lines[3].Visible = true
                    
                    lines[4].Size = UDim2.new(0, thickness, 0, boxH)
                    lines[4].Position = UDim2.new(0, maxX, 0, minY)
                    lines[4].Visible = true
                    
                    for i = 5, #lines do lines[i].Visible = false end

                    data.NameLabel.Position = UDim2.new(0, minX + (boxW / 2), 0, minY - 4)
                    data.NameLabel.Text = string.format("%s | HP: %d | %dm", model.Name, healthVal, distance)
