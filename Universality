local function SkidSelectionAxisFlingModel(TargetData)
    local Character = LocalPlayer.Character
    local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")
    local RootPart = Humanoid and Humanoid.RootPart
    local TCharacter = TargetData.Model
    
    if not TCharacter or not TCharacter.Parent then return end
    
    local THumanoid = TargetData.Humanoid
    if isTargetAnchored(TCharacter, THumanoid) then return end
    
    local TRootPart = THumanoid and THumanoid.RootPart
    local seatPart = THumanoid and THumanoid.SeatPart
    local targetPart = seatPart or TRootPart or TCharacter:FindFirstChild("Head") or TCharacter:FindFirstChildWhichIsA("BasePart")
    
    if targetPart then
        Camera.CameraType = Enum.CameraType.Custom
        LocalPlayer.CameraMaxZoomDistance = 999999
        Camera.CameraSubject = targetPart
    end
    
    if Character and Humanoid and RootPart then
        if not env.OldPos or RootPart.Velocity.Magnitude < 50 then
            env.OldPos = RootPart.CFrame
        end
        
        local baseTargetPart = TCharacter:FindFirstChildWhichIsA("BasePart")
        if not baseTargetPart then return end
        
        local exponentialMultiplier = math.clamp(math.pow(GetModelMass(TCharacter), 1.3), 1, 50)
        
        local function FPosAxis(BasePart)
            local selectedMode = FlingDirections[State.currentDirIndex]
            local velocityTarget = Vector3.new()
            
            State.orbitAngleCounter = State.orbitAngleCounter + State.orbitSpeed
            local offsetX = math.cos(State.orbitAngleCounter) * 1.2
            local offsetZ = math.sin(State.orbitAngleCounter) * 1.2
            
            local actualTargetPos = (seatPart and seatPart.Position) or (TRootPart and TRootPart.Position) or BasePart.Position
            local targetVelocity = (seatPart and seatPart.AssemblyLinearVelocity) or (TRootPart and TRootPart.AssemblyLinearVelocity) or Vector3.new()
            
            local predictedPos = actualTargetPos
            if State.movementPredictorEnabled and targetVelocity.Magnitude > 0.1 then
                local dist = (RootPart.Position - actualTargetPos).Magnitude
                local dynamicLead = math.clamp(dist / 50 * 0.4, 0.1, 0.5) * math.min(targetVelocity.Magnitude / 16, 2)
                predictedPos = actualTargetPos + (targetVelocity * dynamicLead)
            end
            
            local targetDestPos = predictedPos + Vector3.new(offsetX, 0.5, offsetZ)
            
            if selectedMode == "The Skies" then
                velocityTarget = Vector3.new(0, 1.5e9, 0) * exponentialMultiplier
            elseif selectedMode == "The Abyss" then
                velocityTarget = Vector3.new(0, -1.5e9, 0) * exponentialMultiplier
            elseif selectedMode == "The Null" then
                velocityTarget = Vector3.new(math.random(-1.5e9, 1.5e9), math.random(-1.5e9, 1.5e9), math.random(-1.5e9, 1.5e9))
            end
            
            local maxSpinAngle = tick() * State.spinSpeed
            local faceCFrame = CFrame.new(targetDestPos) * CFrame.Angles(maxSpinAngle, maxSpinAngle * 1.5, maxSpinAngle * 0.8)

            if State.seatedFlingEnabled then
                Humanoid.Sit = true
                RootPart.CFrame = faceCFrame
                RootPart.Velocity = velocityTarget
                RootPart.RotVelocity = Vector3.new(1.5e9, 1.5e9, 1.5e9)
            else
                RootPart.CFrame = faceCFrame
                Character:SetPrimaryPartCFrame(faceCFrame)
                RootPart.Velocity = velocityTarget
                RootPart.RotVelocity = Vector3.new(1.5e9, 1.5e9, 1.5e9)
            end
        end
        
        Workspace.FallenPartsDestroyHeight = 0/0
        local BV = Instance.new("BodyVelocity")
        BV.Parent = RootPart
        BV.Velocity = Vector3.new()
        BV.MaxForce = Vector3.new(9e9, 9e9, 9e9)
        
        if State.seatedFlingEnabled then
            Humanoid.Sit = true
            Humanoid:SetStateEnabled(Enum.HumanoidStateType.Seated, true)
        else
            Humanoid:SetStateEnabled(Enum.HumanoidStateType.Seated, false)
            Humanoid:SetStateEnabled(Enum.HumanoidStateType.Swimming, true)
            Humanoid:ChangeState(Enum.HumanoidStateType.Swimming)
        end
        
        if Physics.flingSwimBv then Physics.flingSwimBv:Destroy() end
        Physics.flingSwimBv = Instance.new("BodyVelocity")
        Physics.flingSwimBv.MaxForce = Vector3.new(9e4, 9e4, 9e4)
        Physics.flingSwimBv.Velocity = Vector3.new(0, 0, 0)
        Physics.flingSwimBv.Parent = RootPart
        
        local startTime = tick()
        repeat
            if RootPart and THumanoid then
                if State.seatedFlingEnabled then
                    Humanoid.Sit = true
                else
                    if Humanoid:GetState() ~= Enum.HumanoidStateType.Swimming then
                        Humanoid:SetStateEnabled(Enum.HumanoidStateType.Swimming, true)
                        Humanoid:ChangeState(Enum.HumanoidStateType.Swimming)
                    end
                end
                FPosAxis(targetPart)
                task.wait()
            end
        until startTime + 2 < tick() or not State.FlingActive
        
        if Physics.flingSwimBv then Physics.flingSwimBv:Destroy() Physics.flingSwimBv = nil end
        BV:Destroy()
        
        if State.seatedFlingEnabled then
            Humanoid.Sit = true
            Humanoid:SetStateEnabled(Enum.HumanoidStateType.Seated, true)
        else
            Humanoid:SetStateEnabled(Enum.HumanoidStateType.Seated, true)
            Humanoid:SetStateEnabled(Enum.HumanoidStateType.Swimming, false)
            Humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
        end
    end
end

local function ReturnToOriginalPosition()
    if Physics.flingSwimBv then Physics.flingSwimBv:Destroy() Physics.flingSwimBv = nil end
    local character = LocalPlayer.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local rootPart = humanoid and humanoid.RootPart
    
    if character and rootPart and env.OldPos then
        local startTime = tick()
        repeat
            if State.seatedFlingEnabled then
                humanoid.Sit = true
            end
            rootPart.CFrame = env.OldPos * CFrame.new(0, 0.5, 0)
            character:SetPrimaryPartCFrame(env.OldPos * CFrame.new(0, 0.5, 0))
            if not State.seatedFlingEnabled then
                humanoid:ChangeState("GettingUp")
            end
            for _, part in pairs(character:GetChildren()) do
                if part:IsA("BasePart") then part.Velocity, part.RotVelocity = Vector3.new(), Vector3.new() end
            end
            task.wait()
        until (rootPart.Position - env.OldPos.p).Magnitude < 15 or (tick() - startTime) > 2
        
        Workspace.FallenPartsDestroyHeight = env.FPDH
    end

    Camera.CameraType = Enum.CameraType.Custom
    Camera.CameraSubject = humanoid
end

