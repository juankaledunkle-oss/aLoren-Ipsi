-- Accurate weight calculation using part:GetMass()
local function getModelMassKg(model)
    local totalMass = 0
    pcall(function()
        for _, part in ipairs(model:GetDescendants()) do
            if part:IsA("BasePart") then
                totalMass = totalMass + part:GetMass()
            end
        end
    end)
    return math.floor(totalMass)
end

local function isTargetAnchored(charModel, humanoid)
    if not State.autoIgnoreAnchoredEnabled then return false end
    local rootPart = getCharacterRoot(charModel)
    if rootPart and rootPart.Anchored then return true end

    if humanoid and humanoid.Sit and humanoid.SeatPart then
        local seat = humanoid.SeatPart
        if seat.Anchored or (seat.AssemblyRootPart and seat.AssemblyRootPart.Anchored) then
            return true
        end
    end
    return false
end

-- Helper specifically for ESP anchoring filter
local function isModelAnchoredForESP(model, humanoid)
    if not State.espIgnoreAnchoredEnabled then return false end
    local rootPart = getCharacterRoot(model)
    if rootPart and rootPart.Anchored then return true end

    if humanoid and humanoid.Sit and humanoid.SeatPart then
        local seat = humanoid.SeatPart
        if seat.Anchored or (seat.AssemblyRootPart and seat.AssemblyRootPart.Anchored) then
            return true
        end
    end
    return false
end

