        local rootPart = model:FindFirstChild("HumanoidRootPart") or model:FindFirstChild("PrimaryPart") or model:FindFirstChildWhichIsA("BasePart")
        local isValid = model.Parent and hum and rootPart and hum.Health > 0

        if isValid then
            local espColor = getESPColor(model)
