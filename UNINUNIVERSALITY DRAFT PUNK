local function collectAliveHumanoids(myChar, originPos)
	local list, seen = {}, {}
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= LocalPlayer and plr.Character then
			local hum = plr.Character:FindFirstChildOfClass("Humanoid")
			local root = getCharacterRoot(plr.Character)
			if hum and hum.Health > 0 and not seen[plr.Character] then
				seen[plr.Character] = true
				table.insert(list, {
					Name = plr.Name,
					DisplayName = plr.DisplayName,
					Model = plr.Character,
					Humanoid = hum,
					IsPlayer = true,
					Distance = root and (originPos - root.Position).Magnitude or math.huge
				})
			end
		end
	end
	for hum in pairs(trackedHumanoids) do
		local model = hum and hum.Parent
		if model and model:IsA("Model") and model ~= myChar and not seen[model] and hum.Health > 0 then
			seen[model] = true
			local root = getCharacterRoot(model)
			table.insert(list, {
				Name = model.Name,
				DisplayName = model.Name,
				Model = model,
				Humanoid = hum,
				IsPlayer = Players:GetPlayerFromCharacter(model) ~= nil,
				Distance = root and (originPos - root.Position).Magnitude or math.huge
			})
		end
	end
	return list
end

RefreshGotoLists = function()
	if State.isTerminated then return end
	local myChar = LocalPlayer.Character
	local myRoot = getCharacterRoot(myChar)
	local cam = getActiveCamera()
	local originPos = myRoot and myRoot.Position or (cam and cam.CFrame.Position or Vector3.zero)

	local vessels, abominations = {}, {}
	for _, item in ipairs(collectAliveHumanoids(myChar, originPos)) do
		table.insert(item.IsPlayer and vessels or abominations, item)
	end
	table.sort(vessels, function(a, b) return a.Name:lower() < b.Name:lower() end)
	table.sort(abominations, function(a, b) return a.Name:lower() < b.Name:lower() end)

	local filterText = gotoSearchBox.Text:lower():gsub("^%s+", ""):gsub("%s+$", "")
	populateGotoColumn(gotoVesselsScroll, vessels, filterText, true)
	populateGotoColumn(gotoAbomsScroll, abominations, filterText, false)
end

