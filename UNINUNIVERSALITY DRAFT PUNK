local function suppressSwimAnimations(humanoid)
	local animator = humanoid and humanoid:FindFirstChildOfClass("Animator")
	if not animator then return end
	for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
		local animName = (track.Animation and track.Animation.Name:lower()) or track.Name:lower()
		if string.find(animName, "swim", 1, true) then pcall(function() track:Stop(0) end) end
	end
end

local function clearFlingMovers()
	destroyPhysicsKey("flingSwimBv")
	destroyPhysicsKey("flingBodyVel")
	destroyPhysicsKey("flingBodyAngVel")
end

local function computePredictedTargetPos(rootPart, targetPart, targetHum, lastVel, dt)
	local actualPos = targetPart.Position
	local targetVel = targetPart.AssemblyLinearVelocity
	if not State.movementPredictorEnabled or targetVel.Magnitude < 0.25 then return actualPos, targetVel end

	local safeDt = math.clamp(dt or (1 / 60), 1 / 240, 0.1)
	local dist = (rootPart.Position - actualPos).Magnitude
	local okPing, rawPing = pcall(function() return LocalPlayer:GetNetworkPing() end)
	local pingOffset = okPing and math.clamp(rawPing or 0.05, 0, 0.22) or 0.05

	local distFactor = math.clamp((dist - 1.5) / 45, 0, 1)
	local speedFactor = math.clamp(targetVel.Magnitude / 24, 0.35, 1.4)
	local leadTime = math.clamp((distFactor * 0.32 * speedFactor) + (pingOffset * 0.85), 0, FlingConfig.MaxLeadSeconds)

	local accel = (targetVel - lastVel) / safeDt
	if accel.Magnitude > 0.1 and targetVel.Unit:Dot(accel.Unit) < -0.2 then leadTime *= 0.5 end

	local isAirborne = false
	if targetHum then
		local okFloor, floorMat = pcall(function() return targetHum.FloorMaterial end)
		isAirborne = (okFloor and floorMat == Enum.Material.Air) or math.abs(targetVel.Y) > 2
	end

	local horiz = Vector3.new(targetVel.X, 0, targetVel.Z) * leadTime
	local vertY = isAirborne
		and ((targetVel.Y * leadTime) - (0.5 * (Workspace.Gravity or 196.2) * leadTime * leadTime))
		or (targetVel.Y * leadTime)
	return actualPos + Vector3.new(horiz.X, vertY, horiz.Z), targetVel
end

local function computeLaunchVelocity(modeName, massScale)
	local mag = FlingConfig.ImpulseMagnitude * massScale
	if modeName == "The Skies" then return Vector3.new(0, mag, 0) end
	if modeName == "The Abyss" then return Vector3.new(0, -mag, 0) end
	return Vector3.new(math.random(-mag, mag), math.random(-mag, mag), math.random(-mag, mag))
end

local function cleanupFlingStepState(animSuppressConn, humanoid)
	if animSuppressConn then pcall(function() animSuppressConn:Disconnect() end) end
	clearFlingMovers()
	if humanoid and humanoid.Parent and not State.seatedFlingEnabled then
		pcall(function()
			humanoid:SetStateEnabled(Enum.HumanoidStateType.Seated, true)
			humanoid:SetStateEnabled(Enum.HumanoidStateType.Swimming, false)
			humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
		end)
	end
end

local function peakFlingModel(targetData, runToken)
	if State.isTerminated or not State.FlingActive or State.flingRunToken ~= runToken then return end
	local Character = LocalPlayer.Character
	local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")
	local RootPart = (Humanoid and Humanoid.RootPart) or getCharacterRoot(Character)
	local TCharacter = targetData and targetData.Model
	local cam = getActiveCamera()
	if not Character or not Character.Parent or not Humanoid or not RootPart or not TCharacter or not TCharacter.Parent then return end

	local THumanoid = targetData.Humanoid
	if isTargetAnchored(TCharacter, THumanoid) then return end
	local TRootPart = (THumanoid and THumanoid.RootPart) or getCharacterRoot(TCharacter)
	local targetPart = (THumanoid and THumanoid.SeatPart) or TRootPart or TCharacter:FindFirstChild("Head") or TCharacter:FindFirstChildWhichIsA("BasePart")
	if not targetPart then return end

	if cam then
		pcall(function()
			cam.CameraType = Enum.CameraType.Custom
			LocalPlayer.CameraMaxZoomDistance = 999999
			cam.CameraSubject = targetPart
		end)
	end

	clearFlingMovers()
	local bv = Instance.new("BodyVelocity")
	bv.MaxForce = Vector3.one * 1e7
	bv.Velocity = Vector3.zero
	bv.Parent = RootPart
	Physics.flingBodyVel = bv

	local bav = Instance.new("BodyAngularVelocity")
	bav.MaxTorque = Vector3.one * 1e7
	bav.AngularVelocity = Vector3.new(0, FlingConfig.AngularVelocityMagnitude, 0)
	bav.Parent = RootPart
	Physics.flingBodyAngVel = bav

	local animSuppressConn
	if State.seatedFlingEnabled then
		pcall(function()
			Humanoid.Sit = true
			Humanoid:SetStateEnabled(Enum.HumanoidStateType.Seated, true)
		end)
	else
		pcall(function()
			Humanoid:SetStateEnabled(Enum.HumanoidStateType.Seated, false)
			Humanoid:SetStateEnabled(Enum.HumanoidStateType.Swimming, true)
			Humanoid:ChangeState(Enum.HumanoidStateType.Swimming)
		end)
		suppressSwimAnimations(Humanoid)
		local animator = Humanoid:FindFirstChildOfClass("Animator")
		if animator then
			animSuppressConn = animator.AnimationPlayed:Connect(function(track)
				local animName = (track.Animation and track.Animation.Name:lower()) or track.Name:lower()
				if string.find(animName, "swim", 1, true) then pcall(function() track:Stop(0) end) end
			end)
		end
	end

	pcall(function() Workspace.FallenPartsDestroyHeight = 0/0 end)
	local massScale = math.clamp(math.pow(math.max(getModelMassKg(TCharacter), 1), 1.15), 1, 25)
	local lastVel, lastSample, startedAt = targetPart.AssemblyLinearVelocity, tick(), tick()

	while State.FlingActive and not State.isTerminated and State.flingRunToken == runToken do
		if not Character.Parent or LocalPlayer.Character ~= Character then cleanupFlingStepState(animSuppressConn, Humanoid) return end
		if not RootPart.Parent then
			RootPart = (Humanoid and Humanoid.RootPart) or getCharacterRoot(Character)
			if not RootPart then cleanupFlingStepState(animSuppressConn, Humanoid) return end
		end
		if not TCharacter.Parent or isTargetAnchored(TCharacter, THumanoid) or (tick() - startedAt) >= FlingConfig.MaxLungeSeconds then break end

		local now = tick()
		local predictedPos, currentVel = computePredictedTargetPos(RootPart, targetPart, THumanoid, lastVel, now - lastSample)
		lastSample, lastVel = now, currentVel
		if currentVel.Magnitude >= FlingConfig.EarlyExitSpeed then break end

		State.orbitAngleCounter += FlingConfig.OrbitStep
		local microOffset = Vector3.new(math.cos(State.orbitAngleCounter) * FlingConfig.OrbitRadius, 0, math.sin(State.orbitAngleCounter) * FlingConfig.OrbitRadius)
		local contactCFrame = CFrame.lookAt(predictedPos + microOffset, predictedPos) * CFrame.Angles(math.rad(90), 0, 0)
		local launchVel = computeLaunchVelocity(FlingDirections[State.currentDirIndex], massScale)

		pcall(function()
			if State.seatedFlingEnabled then
				Humanoid.Sit = true
			elseif Humanoid:GetState() ~= Enum.HumanoidStateType.Swimming then
				Humanoid:ChangeState(Enum.HumanoidStateType.Swimming)
			end
			RootPart.CFrame = contactCFrame
			RootPart.AssemblyLinearVelocity = launchVel
			RootPart.AssemblyAngularVelocity = Vector3.new(0, FlingConfig.AngularVelocityMagnitude, 0)
			if bv.Parent == RootPart then bv.Velocity = launchVel end
		end)
		RunService.Heartbeat:Wait()
	end
	cleanupFlingStepState(animSuppressConn, Humanoid)
end

local function ReturnToOriginalPosition()
	clearFlingMovers()
	local character = LocalPlayer.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local rootPart = (humanoid and humanoid.RootPart) or getCharacterRoot(character)

	if character and character.Parent and rootPart and env.OldPos then
		local startTime = tick()
		repeat
			if not character.Parent or LocalPlayer.Character ~= character then break end
			pcall(function()
				if State.seatedFlingEnabled and humanoid then
					humanoid.Sit = true
				elseif humanoid then
					humanoid:SetStateEnabled(Enum.HumanoidStateType.Seated, true)
					humanoid:SetStateEnabled(Enum.HumanoidStateType.Swimming, false)
					humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
				end
				rootPart.CFrame = env.OldPos * CFrame.new(0, 0.5, 0)
				rootPart.AssemblyLinearVelocity = Vector3.zero
				rootPart.AssemblyAngularVelocity = Vector3.zero
				for _, part in ipairs(character:GetChildren()) do
					if part:IsA("BasePart") then part.Velocity, part.RotVelocity = Vector3.zero, Vector3.zero end
				end
			end)
			task.wait()
		until (rootPart.Position - env.OldPos.Position).Magnitude < 12 or (tick() - startTime) > 1.5
	end

	pcall(function() Workspace.FallenPartsDestroyHeight = env.FPDH end)
	local cam = getActiveCamera()
	if cam and humanoid and humanoid.Parent then
		pcall(function() cam.CameraType, cam.CameraSubject = Enum.CameraType.Custom, humanoid end)
	end
end

local function finishFlingLoopNaturally(runToken)
	if State.flingRunToken ~= runToken then return end
	State.FlingActive = false
	clearFlingMovers()
	pcall(function() Workspace.FallenPartsDestroyHeight = env.FPDH end)
	local cam = getActiveCamera()
	local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
	if cam and hum then pcall(function() cam.CameraType, cam.CameraSubject = Enum.CameraType.Custom, hum end) end
	if UpdateFlingStatus then pcall(UpdateFlingStatus) end
end

