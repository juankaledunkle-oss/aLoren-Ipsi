-- Unified RenderStepped Loop (Metrics + Hover + ESP)
local raycastParams = RaycastParams.new()
raycastParams.FilterType = Enum.RaycastFilterType.Exclude
local cornersBuffer = table.create(8)

trackConnection(RunService.RenderStepped:Connect(function(dt)
	if State.isTerminated then return end
	local fps = dt > 0 and math.floor(1 / dt) or 60
	topBarFpsLabel.Text = "FPS: " .. fps
	topBarFpsLabel.TextColor3 = fps >= 50 and Color3.fromRGB(255, 100, 100) or (fps >= 30 and Color3.fromRGB(255, 180, 100) or Color3.fromRGB(255, 50, 50))

	local char = LocalPlayer.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local root = getCharacterRoot(char)
	local cam = getActiveCamera()

	pcall(function()
		if statLabels["Name"] then
			statLabels["Name"].Text = LocalPlayer.Name
			statLabels["Health"].Text = hum and string.format("%d / %d", math.floor(hum.Health), math.floor(hum.MaxHealth)) or "N/A"
			local vel = root and root.AssemblyLinearVelocity or Vector3.zero
			statLabels["Speed (Studs/s)"].Text = string.format("%.1f studs/s", math.sqrt(vel.X * vel.X + vel.Z * vel.Z))
			statLabels["WalkSpeed"].Text = hum and tostring(math.floor(hum.WalkSpeed)) or "N/A"
			local jumpVal = 0
			if hum then
				local ok, val = pcall(function() return hum.UseJumpPower and hum.JumpPower or hum.JumpHeight end)
				jumpVal = ok and (val or 0) or (hum.JumpPower or 0)
			end
			statLabels["JumpHeight"].Text = string.format("%.1f", jumpVal)
			local stateName = "Unknown"
			if hum then pcall(function() stateName = hum:GetState().Name end) end
			statLabels["Status"].Text = stateName
			statLabels["Weight (kg)"].Text = string.format("%d kg", char and getModelMassKg(char) or 0)
			statLabels["Gravity"].Text = string.format("%.1f", Workspace.Gravity)
			local pos = root and root.Position or Vector3.zero
			statLabels["Coordinates"].Text = string.format("%d, %d, %d", math.round(pos.X), math.round(pos.Y), math.round(pos.Z))
		end
	end)

	if State.hoverEnabled and not State.flyEnabled and not State.FlingActive and root then
		pcall(function()
			raycastParams.FilterDescendantsInstances = {char}
			local rayResult = Workspace:Raycast(root.Position + Vector3.new(0, 3.8, 0), Vector3.new(0, -150, 0), raycastParams)
			if rayResult then
				local targetHeight = rayResult.Position.Y + 50.0
				if root.Position.Y < targetHeight or root.AssemblyLinearVelocity.Y < 1 then
					root.CFrame = CFrame.new(root.Position.X, targetHeight, root.Position.Z) * (root.CFrame - root.CFrame.Position)
					root.AssemblyLinearVelocity = Vector3.new(root.AssemblyLinearVelocity.X, 0, root.AssemblyLinearVelocity.Z)
				end
			end
		end)
	end

	if not State.humEspEnabled or not cam then return end
	local localPos = root and root.Position or cam.CFrame.Position

	for model, data in pairs(espCache) do
		local mHum = model:FindFirstChildOfClass("Humanoid")
		local rootPart = getCharacterRoot(model)

		if model.Parent and mHum and rootPart and mHum.Health > 0 and not isModelAnchoredForESP(model, mHum) then
			local isPlayer = Players:GetPlayerFromCharacter(model) ~= nil
			local espColor = isPlayer and Colors.VesselOutline or Colors.AbomOutline
			local fillCol = isPlayer and Colors.VesselFill or Colors.AbomFill
			local textColor = isPlayer and Colors.VesselText or Colors.AbomText
			local strokeColor = isPlayer and Color3.new(0, 0, 0) or Colors.AbomStroke

			if data.Highlight and data.Highlight.OutlineColor ~= espColor then
				pcall(function()
					data.Highlight.FillColor = fillCol
					data.Highlight.OutlineColor = espColor
				end)
				data.NameLabel.TextColor3 = textColor
				data.HealthBarFill.BackgroundColor3 = espColor
				data.NameLabel.TextStrokeColor3 = strokeColor
				for _, line in ipairs(data.BoxLines) do line.BackgroundColor3 = espColor end
			end
			if data.Highlight then pcall(function() data.Highlight.Enabled = true end) end

			local cf, size
			local okBox = pcall(function() cf, size = model:GetBoundingBox() end)
			if not okBox or not cf or not size then cf, size = rootPart.CFrame, rootPart.Size end
			cf += Vector3.new(0, 2, 0)
			local hX, hY, hZ = size.X / 2, size.Y / 2, size.Z / 2

			cornersBuffer[1] = cf * Vector3.new(-hX, -hY, -hZ)
			cornersBuffer[2] = cf * Vector3.new(hX, -hY, -hZ)
			cornersBuffer[3] = cf * Vector3.new(hX, hY, -hZ)
			cornersBuffer[4] = cf * Vector3.new(-hX, hY, -hZ)
			cornersBuffer[5] = cf * Vector3.new(-hX, -hY, hZ)
			cornersBuffer[6] = cf * Vector3.new(hX, -hY, hZ)
			cornersBuffer[7] = cf * Vector3.new(hX, hY, hZ)
			cornersBuffer[8] = cf * Vector3.new(-hX, hY, hZ)

			local minX, minY, maxX, maxY, onScreenCount = math.huge, math.huge, -math.huge, -math.huge, 0
			for i = 1, 8 do
				local screenPos, onScreen = cam:WorldToViewportPoint(cornersBuffer[i])
				if onScreen then onScreenCount += 1 end
				if screenPos.X < minX then minX = screenPos.X end
				if screenPos.X > maxX then maxX = screenPos.X end
				if screenPos.Y < minY then minY = screenPos.Y end
				if screenPos.Y > maxY then maxY = screenPos.Y end
			end

			if onScreenCount > 0 then
				local boxW, boxH = maxX - minX, maxY - minY
				local lines = data.BoxLines
				lines[1].Size, lines[1].Position, lines[1].Visible = UDim2.new(0, boxW, 0, 1.5), UDim2.new(0, minX, 0, minY), true
				lines[2].Size, lines[2].Position, lines[2].Visible = UDim2.new(0, boxW, 0, 1.5), UDim2.new(0, minX, 0, maxY), true
				lines[3].Size, lines[3].Position, lines[3].Visible = UDim2.new(0, 1.5, 0, boxH), UDim2.new(0, minX, 0, minY), true
				lines[4].Size, lines[4].Position, lines[4].Visible = UDim2.new(0, 1.5, 0, boxH), UDim2.new(0, maxX, 0, minY), true

				data.NameLabel.Position = UDim2.new(0, minX + (boxW / 2), 0, minY - 4)
				data.NameLabel.Text = string.format("%s | HP: %d | %dkg | %dm", model.Name, math.floor(mHum.Health), getModelMassKg(model), math.floor((localPos - rootPart.Position).Magnitude))
				data.NameLabel.Visible = true

				local hpRatio = math.clamp(mHum.Health / math.max(mHum.MaxHealth, 1), 0, 1)
				data.HealthBarBg.Size, data.HealthBarBg.Position, data.HealthBarBg.Visible = UDim2.new(0, 3, 0, boxH), UDim2.new(0, minX - 6, 0, minY), true
				data.HealthBarFill.Size, data.HealthBarFill.Position = UDim2.new(1, 0, hpRatio, 0), UDim2.new(0, 0, 1 - hpRatio, 0)
			else
				for _, line in ipairs(data.BoxLines) do line.Visible = false end
				data.NameLabel.Visible, data.HealthBarBg.Visible = false, false
			end
		else
			if data.Highlight then pcall(function() data.Highlight.Enabled = false end) end
			for _, line in ipairs(data.BoxLines) do line.Visible = false end
			data.NameLabel.Visible, data.HealthBarBg.Visible = false, false
		end
	end
end))

