local function updateJoystickPos(inputPos)
	local center = joystickFrame.AbsolutePosition + (joystickFrame.AbsoluteSize / 2)
	local delta = inputPos - center
	local maxRadius = math.max(joystickFrame.AbsoluteSize.X / 2, 1)
	if delta.Magnitude > maxRadius then delta = delta.Unit * maxRadius end
	joystickThumb.Position = UDim2.new(0.5, delta.X - 25, 0.5, delta.Y - 25)
	State.joystickDir = Vector2.new(delta.X / maxRadius, -delta.Y / maxRadius)
end

joystickFrame.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		State.joystickDragging = true
		updateJoystickPos(Vector2.new(input.Position.X, input.Position.Y))
	end
end)

trackConnection(UserInputService.InputChanged:Connect(function(input)
	if State.joystickDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
		updateJoystickPos(Vector2.new(input.Position.X, input.Position.Y))
	end
end))

trackConnection(UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		State.joystickDragging = false
		joystickThumb.Position = UDim2.new(0.5, -25, 0.5, -25)
		State.joystickDir = Vector2.zero
	end
end))

local function startJoystick()
	joystickFrame.Visible = true
	disconnectNamed("joystick")
	Connections.joystick = trackConnection(RunService.RenderStepped:Connect(function()
		if State.isTerminated or not State.joystickEnabled or State.flyEnabled or State.swimEnabled then return end
		local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
		local cam = getActiveCamera()
		if hum and cam and State.joystickDir.Magnitude > 0 then
			local camCF = cam.CFrame
			local moveDir = Vector3.new(
				camCF.RightVector.X * State.joystickDir.X + camCF.LookVector.X * State.joystickDir.Y,
				0,
				camCF.RightVector.Z * State.joystickDir.X + camCF.LookVector.Z * State.joystickDir.Y
			)
			if moveDir.Magnitude > 0 then pcall(function() hum:Move(moveDir.Unit, false) end) end
		end
	end))
end

local function stopJoystick()
	joystickFrame.Visible = false
	State.joystickDir, State.joystickDragging = Vector2.zero, false
	joystickThumb.Position = UDim2.new(0.5, -25, 0.5, -25)
	disconnectNamed("joystick")
end

