	Physics.bg.Parent = flyTargetPart

	Physics.bv = Instance.new("BodyVelocity")
	Physics.bv.Velocity, Physics.bv.MaxForce = Vector3.zero, Vector3.one * 9e4
	Physics.bv.Parent = flyTargetPart

	disconnectNamed("fly")
	Connections.fly = trackConnection(RunService.RenderStepped:Connect(function()
		if State.isTerminated then stopFly() return end
		local curHum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
		local cam = getActiveCamera()
		local activeTarget = getControlledPart(curHum, LocalPlayer.Character)
		if not curHum or not cam or not activeTarget then stopFly() return end

		if Physics.bv and Physics.bv.Parent ~= activeTarget then
			Physics.bv.Parent, Physics.bg.Parent = activeTarget, activeTarget
		end
		Physics.bg.CFrame = cam.CFrame
		local moveDir = getFlightMoveDir(curHum, cam)
		Physics.bv.Velocity = moveDir.Magnitude > 0 and moveDir.Unit * State.flySpeed or Vector3.new(0, 0.1, 0)
	end))
end

