	disconnectNamed("fly")
	local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
	if hum then pcall(function() hum.PlatformStand = false end) end
	destroyPhysicsKey("bg")
	destroyPhysicsKey("bv")
end

