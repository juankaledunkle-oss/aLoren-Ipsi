local function createSliderRow(parent, labelText, minVal, maxVal, initialVal, suffix, accentColor, order, onChanged)
	local container = Instance.new("Frame")
	container.Size = UDim2.new(1, 0, 0, 52)
	container.BackgroundColor3 = Colors.OffBg
	container.BackgroundTransparency = 0.3
	container.BorderSizePixel = 0
	container.LayoutOrder = order
	container.Parent = parent
	addCorner(container, 4)

	local clampedInit = math.clamp(initialVal, minVal, maxVal)
	local ratio = (maxVal > minVal) and ((clampedInit - minVal) / (maxVal - minVal)) or 0

	local topLine = Instance.new("Frame")
	topLine.Size = UDim2.new(1, -20, 0, 20)
	topLine.Position = UDim2.new(0, 10, 0, 4)
	topLine.BackgroundTransparency = 1
	topLine.Parent = container

	local title = Instance.new("TextLabel")
	title.Size = UDim2.new(0.65, 0, 1, 0)
	title.BackgroundTransparency = 1
	title.Font = Enum.Font.GothamSemibold
	title.Text = labelText
	title.TextColor3 = Color3.fromRGB(210, 190, 185)
	title.TextSize = 12
	title.TextXAlignment = Enum.TextXAlignment.Left
	title.Parent = topLine

	local valueLabel = Instance.new("TextLabel")
	valueLabel.Size = UDim2.new(0.35, 0, 1, 0)
	valueLabel.Position = UDim2.new(0.65, 0, 0, 0)
	valueLabel.BackgroundTransparency = 1
	valueLabel.Font = Enum.Font.GothamBold
	valueLabel.Text = tostring(clampedInit) .. (suffix or "")
	valueLabel.TextColor3 = accentColor
	valueLabel.TextSize = 12
	valueLabel.TextXAlignment = Enum.TextXAlignment.Right
	valueLabel.Parent = topLine

	local track = Instance.new("Frame")
	track.Size = UDim2.new(1, -20, 0, 8)
	track.Position = UDim2.new(0, 10, 0, 32)
	track.BackgroundColor3 = Color3.fromRGB(14, 10, 13)
	track.BorderSizePixel = 0
	track.Parent = container
	addCorner(track, 4)

	local fill = Instance.new("Frame")
	fill.Size = UDim2.new(ratio, 0, 1, 0)
	fill.BackgroundColor3 = Color3.fromRGB(145, 25, 35)
	fill.BorderSizePixel = 0
	fill.Parent = track
	addCorner(fill, 4)

	local knob = Instance.new("Frame")
	knob.Size = UDim2.new(0, 14, 0, 14)
	knob.AnchorPoint = Vector2.new(0.5, 0.5)
	knob.Position = UDim2.new(ratio, 0, 0.5, 0)
	knob.BackgroundColor3 = accentColor
	knob.BorderSizePixel = 0
	knob.Parent = track
	addCorner(knob, 7)

	local sliding = false
	local function applyFromX(inputX)
		local alpha = math.clamp((inputX - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1)
		local stepped = math.round(minVal + (alpha * (maxVal - minVal)))
		local finalRatio = (maxVal > minVal) and ((stepped - minVal) / (maxVal - minVal)) or 0
		fill.Size = UDim2.new(finalRatio, 0, 1, 0)
		knob.Position = UDim2.new(finalRatio, 0, 0.5, 0)
		valueLabel.Text = tostring(stepped) .. (suffix or "")
		if onChanged then onChanged(stepped) end
	end

	local function beginSlide(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			sliding = true
			applyFromX(input.Position.X)
		end
	end
	track.InputBegan:Connect(beginSlide)
	knob.InputBegan:Connect(beginSlide)

	trackConnection(UserInputService.InputChanged:Connect(function(input)
		if sliding and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			applyFromX(input.Position.X)
		end
	end))
	trackConnection(UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			sliding = false
		end
	end))
end

