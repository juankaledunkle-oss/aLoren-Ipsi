local clonedAvatarModel = nil
local function updateAvatarPreview()
	if State.isTerminated then return end
	pcall(function()
		if clonedAvatarModel then clonedAvatarModel:Destroy() clonedAvatarModel = nil end
		local char = LocalPlayer.Character
		if char then
			char.Archivable = true
			clonedAvatarModel = char:Clone()
			for _, obj in ipairs(clonedAvatarModel:GetDescendants()) do
				if obj:IsA("Script") or obj:IsA("LocalScript") then obj:Destroy() end
			end
			clonedAvatarModel.Parent = avatarViewport
			local rootPart = getCharacterRoot(clonedAvatarModel) or clonedAvatarModel:FindFirstChild("Head") or clonedAvatarModel.PrimaryPart
			if rootPart then
				avCam.CFrame = CFrame.new(rootPart.Position + Vector3.new(0, 0.5, -7.5), rootPart.Position + Vector3.new(0, 0.5, 0))
			end
		end
	end)
end

trackConnection(LocalPlayer.CharacterAdded:Connect(function()
	task.wait(1)
	updateAvatarPreview()
end))
