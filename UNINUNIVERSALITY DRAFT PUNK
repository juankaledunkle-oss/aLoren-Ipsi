local function terminateScript()
	if State.isTerminated then return end
	State.isTerminated = true

	if stopFlingController then pcall(stopFlingController) else State.FlingActive = false end
	if stopCodexUtilities then pcall(stopCodexUtilities) end

	State.hoverEnabled, State.flyEnabled, State.swimEnabled, State.seatedSwimEnabled = false, false, false, false
	State.spinEnabled, State.noclipEnabled, State.infJumpEnabled, State.joystickEnabled, State.humEspEnabled = false, false, false, false, false

	for _, conn in pairs(Connections) do
		if typeof(conn) == "RBXScriptConnection" then pcall(function() conn:Disconnect() end) end
	end
	table.clear(Connections)

	for _, obj in pairs(Physics) do
		if typeof(obj) == "Instance" then pcall(function() obj:Destroy() end) end
	end
	table.clear(Physics)

	for model, data in pairs(espCache) do
		if data then
			if data.Folder then pcall(function() data.Folder:Destroy() end) end
			if data.Highlight then pcall(function() data.Highlight:Destroy() end) end
		end
		espCache[model] = nil
	end
	table.clear(trackedHumanoids)

	pcall(function()
		Lighting.Brightness = originalLighting.Brightness
		Lighting.ClockTime = originalLighting.ClockTime
		Lighting.FogEnd = originalLighting.FogEnd
		Lighting.FogStart = originalLighting.FogStart
		Lighting.GlobalShadows = originalLighting.GlobalShadows
		Lighting.OutdoorAmbient = originalLighting.OutdoorAmbient
	end)

	pcall(function()
		LocalPlayer.CameraMaxZoomDistance = originalCameraSettings.CameraMaxZoomDistance
		LocalPlayer.CameraMinZoomDistance = originalCameraSettings.CameraMinZoomDistance
		LocalPlayer.CameraMode = originalCameraSettings.CameraMode
		LocalPlayer.DevCameraOcclusionMode = originalCameraSettings.DevCameraOcclusionMode
		local cam = getActiveCamera()
		if cam then
			cam.CameraType = Enum.CameraType.Custom
			cam.CameraSubject = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
			cam.FieldOfView = originalCameraSettings.FieldOfView
		end
	end)

	pcall(function() RunService:Set3dRenderingEnabled(true) end)
	pcall(function() Workspace.FallenPartsDestroyHeight = env.FPDH end)
	pcall(function() if screenGui then screenGui:Destroy() end)
	destroyAllExistingGuis()

	if env.CultOfEntropyInstance and env.CultOfEntropyInstance.Id == State then env.CultOfEntropyInstance = nil end
	if env.CultOfEntropyFling and env.CultOfEntropyFling.Id == State then env.CultOfEntropyFling = nil end
end

