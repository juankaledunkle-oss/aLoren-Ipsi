local function createESPForModel(model)
	if State.isTerminated or espCache[model] or model == LocalPlayer.Character then return end

	local espFolder = Instance.new("Folder")
	espFolder.Name = "ESPContainerFolder"
	espFolder.Parent = screenGui

	local isPlayer = Players:GetPlayerFromCharacter(model) ~= nil
	local initialColor = isPlayer and Colors.VesselOutline or Colors.AbomOutline
	local initialFill = isPlayer and Colors.VesselFill or Colors.AbomFill
	local initialTextColor = isPlayer and Colors.VesselText or Colors.AbomText
	local initialStrokeColor = isPlayer and Color3.new(0, 0, 0) or Colors.AbomStroke

	local boxLines = {}
	for i = 1, 4 do
		local line = Instance.new("Frame")
		line.BackgroundColor3 = initialColor
		line.BorderSizePixel = 0
		line.Visible = false
		line.Parent = espFolder
		boxLines[i] = line
	end

	local nameLabel = Instance.new("TextLabel")
	nameLabel.BackgroundTransparency = 1
	nameLabel.Size = UDim2.new(2, 0, 0, 18)
	nameLabel.AnchorPoint = Vector2.new(0.5, 1)
	nameLabel.Font = Enum.Font.GothamBold
	nameLabel.TextSize = 12
	nameLabel.TextColor3 = initialTextColor
	nameLabel.TextStrokeTransparency = 0.3
	nameLabel.TextStrokeColor3 = initialStrokeColor
	nameLabel.TextXAlignment = Enum.TextXAlignment.Center
	nameLabel.Parent = espFolder

	local healthBarBg = Instance.new("Frame")
	healthBarBg.Size = UDim2.new(0, 4, 0, 0)
	healthBarBg.BackgroundColor3 = Color3.fromRGB(20, 10, 12)
	healthBarBg.BorderSizePixel = 0
	healthBarBg.Visible = false
	healthBarBg.Parent = espFolder

	local healthBarFill = Instance.new("Frame")
	healthBarFill.Size = UDim2.new(1, 0, 1, 0)
	healthBarFill.BackgroundColor3 = initialColor
	healthBarFill.BorderSizePixel = 0
	healthBarFill.Parent = healthBarBg

	local highlight = Instance.new("Highlight")
	highlight.Name = "UniversalBodyPartHighlight"
	highlight.Adornee = model
	highlight.FillColor = initialFill
	highlight.FillTransparency = 0.3
	highlight.OutlineColor = initialColor
	highlight.OutlineTransparency = 0
	highlight.Enabled = false
	pcall(function() highlight.Parent = model end)

	espCache[model] = {
		Folder = espFolder,
		BoxLines = boxLines,
		NameLabel = nameLabel,
		HealthBarBg = healthBarBg,
		HealthBarFill = healthBarFill,
		Highlight = highlight
	}
