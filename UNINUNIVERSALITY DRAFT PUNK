local function startSwim()
	local char = LocalPlayer.Character
	local root = getCharacterRoot(char)
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not root or not hum then return end

	pcall(function()
		hum:SetStateEnabled(Enum.HumanoidStateType.Swimming, true)
		hum:ChangeState(Enum.HumanoidStateType.Swimming)
	end)

	destroyPhysicsKey("swimBv")
	Physics.swimBv = Instance.new("BodyVelocity")
	Physics.swimBv.MaxForce, Physics.swimBv.Velocity = Vector3.one * 9e4, Vector3.zero
	Physics.swimBv.Parent = root

	disconnectNamed("swim")
	Connections.swim = trackConnection(RunService.Heartbeat:Connect(function()
		if State.isTerminated then return end
		local curChar = LocalPlayer.Character
		local curHum = curChar and curChar:FindFirstChildOfClass("Humanoid")
		local curRoot = getCharacterRoot(curChar)
		local cam = getActiveCamera()
		if not curHum or not curRoot or not cam then return end

		pcall(function()
			if curHum:GetState() ~= Enum.HumanoidStateType.Swimming then curHum:ChangeState(Enum.HumanoidStateType.Swimming) end
		end)
		if State.FlingActive then
			if Physics.swimBv then Physics.swimBv.MaxForce = Vector3.zero end
			return
		end
		if not Physics.swimBv or Physics.swimBv.Parent ~= curRoot then
			destroyPhysicsKey("swimBv")
			Physics.swimBv = Instance.new("BodyVelocity")
			Physics.swimBv.Parent = curRoot
		end
		Physics.swimBv.MaxForce = Vector3.one * 9e4
		local moveDir = getFlightMoveDir(curHum, cam)
		Physics.swimBv.Velocity = moveDir.Magnitude > 0
			and moveDir.Unit * curHum.WalkSpeed
			or (State.cachedWaterCount > 0 and Vector3.new(0, -2, 0) or Vector3.zero)
	end))
end

local function stopSwim()
	disconnectNamed("swim")
	destroyPhysicsKey("swimBv")
	local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
	if hum then
		pcall(function()
			hum:SetStateEnabled(Enum.HumanoidStateType.Swimming, false)
			hum:ChangeState(Enum.HumanoidStateType.GettingUp)
		end)
	end
end

