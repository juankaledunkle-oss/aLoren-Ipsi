local function GetCategorizedTargets()
	local playerTargets, entityTargets = {}, {}
	local localChar = LocalPlayer.Character
	local cam = getActiveCamera()
	local localRoot = getCharacterRoot(localChar)
	local localPos = localRoot and localRoot.Position or (cam and cam.CFrame.Position or Vector3.zero)

	for _, item in ipairs(collectAliveHumanoids(localChar, localPos)) do
		if not isTargetAnchored(item.Model, item.Humanoid) then
			table.insert(item.IsPlayer and playerTargets or entityTargets, item)
		end
	end

	local sortFunc = State.targetNearestEnabled
		and function(a, b) return a.Distance < b.Distance end
		or function(a, b) return a.Name:lower() < b.Name:lower() end
	table.sort(playerTargets, sortFunc)
	table.sort(entityTargets, sortFunc)
	return playerTargets, entityTargets
end

local function GetNearestSingleTarget()
	local pTargets, eTargets = GetCategorizedTargets()
	local all = {}
	for _, t in ipairs(pTargets) do table.insert(all, t) end
	for _, t in ipairs(eTargets) do table.insert(all, t) end
	table.sort(all, function(a, b) return a.Distance < b.Distance end)
	return all[1]
end

