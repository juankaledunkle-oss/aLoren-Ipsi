    tab3Btn.BackgroundColor3 = Color3.fromRGB(30, 36, 48)
    tab3Btn.TextColor3 = Color3.fromRGB(150, 220, 255)
    
    activeContainer.Visible = true
    activeBtn.BackgroundColor3 = Color3.fromRGB(35, 75, 110)
    activeBtn.TextColor3 = Color3.fromRGB(200, 245, 255)
end

