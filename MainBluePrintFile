-- Window Dragging Logic
local dragging = false
local dragInput, dragStart, startPos

topBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = mainWindow.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then dragging = false end
        end)
    end
end)

topBar.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        dragInput = input
    end
end)

UserInputService.InputChanged:Connect(function()
    if dragInput and dragging then
        local delta = dragInput.Position - dragStart
        mainWindow.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)

-- Minimize & Close Handlers
local isMinimized = false
local normalSize = UDim2.new(0, 600, 0, 670)
local minimizedSize = UDim2.new(0, 600, 0, 35)

minimizeButton.MouseButton1Click:Connect(function()
    isMinimized = not isMinimized
    categoryBar.Visible = not isMinimized
    container1.Visible = not isMinimized and (tab1Btn.BackgroundColor3 == Color3.fromRGB(35, 75, 110))
    container2.Visible = not isMinimized and (tab2Btn.BackgroundColor3 == Color3.fromRGB(35, 75, 110))
    container3.Visible = not isMinimized and (tab3Btn.BackgroundColor3 == Color3.fromRGB(35, 75, 110))
    mainWindow.Size = isMinimized and minimizedSize or normalSize
    minimizeButton.Text = isMinimized and "+" or "-"
end)

